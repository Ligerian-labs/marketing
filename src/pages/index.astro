---
export const prerender = true;
import Base from "../layouts/Base.astro";
import SectionBar from "../components/SectionBar.astro";
import ProjectOffers from "../components/ProjectOffers.astro";
import ProofSection from "../components/ProofSection.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCollection } from "astro:content";
import { formatDate, readingTimeFromBody } from "../lib/blog";

const posts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const questions = [
  {
    q: "Vos équipes jonglent avec des tableurs ?",
    a: "Un outil métier peut réunir le suivi des dossiers, les règles de calcul et les tâches qui passent aujourd'hui d'un fichier à l'autre.",
  },
  {
    q: "Vos clients ont besoin d'un espace à eux ?",
    a: "Un portail peut leur permettre de déposer des documents, suivre une demande et retrouver les informations que vous leur envoyez par mail.",
  },
  {
    q: "Votre application existe, mais elle n'avance plus ?",
    a: "Nous examinons ce qui fonctionne et ce qui bloque pour proposer une reprise ciblée ou une reconstruction justifiée.",
  },
];

// La Loire, mean flow. Bar heights in %; the cobalt run is the spring rise.
const flow = [34, 52, 44, 68, 88, 100, 76, 58, 41, 30, 24];
---

<Base
  title="Logiciels sur mesure · création, reprise et suivi | Ligerian Labs"
  description="Création de logiciels à 2 000 € par mois pendant la construction, reprise de l'existant après diagnostic, puis hébergement et maintenance sur devis. À Angers et à distance."
  ogTitle="Votre logiciel, construit et maintenu avec un budget clair"
  ogDescription="2 000 € par mois pendant la construction. Reprise de logiciels existants et abonnement de suivi adapté après livraison."
  ogImage="og-accueil"
>
  <header class="ll-sec">
    <div class="ll-wrap ll-hero ll-hero--wide">
      <div class="ll-hero__main" style="gap:26px">
        <div class="ll-mono" style="font-size:12px;letter-spacing:.16em">
          Logiciels sur mesure · Angers, Pays de la Loire
        </div>
        <h1 class="ll-display">
          Votre logiciel.<br />Un budget<br />clair.
        </h1>
        <p class="ll-lede ll-lede--strong">
          Application métier, espace client ou outil d'automatisation : nous construisons votre
          logiciel ou reprenons votre existant, puis assurons son suivi après livraison.
        </p>
        <div class="ll-btn-row" style="margin-top:6px">
          <a href="/contact?projet=creation" class="ll-btn ll-btn--lg">Décrire mon projet →</a>
          <a href="/contact?projet=reprise" class="ll-btn ll-btn--lg ll-btn--ghost">Faire reprendre mon logiciel</a>
        </div>
      </div>

      <div class="ll-hero__aside ll-hero__aside--cobalt" style="gap:28px;min-height:340px">
        <div class="ll-mono" style="color:inherit">Pendant la construction</div>
        <div style="display:flex;flex-direction:column;gap:16px">
          <div class="ll-kicker">2 000 €<br />par mois</div>
          <p style="margin:0;font-size:16px;line-height:1.55">
            Un périmètre initial et un budget cible définis ensemble. Après livraison, un abonnement
            moins élevé prend le relais pour l'hébergement, la maintenance et les évolutions convenues.
          </p>
        </div>
        <a href="/offres#budget" class="ll-btn ll-btn--cream" style="align-self:flex-start">
          Comprendre le tarif →
        </a>
      </div>
    </div>
  </header>

  <SectionBar label="01 · Votre besoin" note="Exemples de projets possibles" />

  <section class="ll-sec">
    <div class="ll-wrap" style="padding-top:clamp(38px,5vw,68px)">
      <h2 class="ll-h2" style="margin-bottom:16px">Un outil adapté<br />à votre activité</h2>
      <p class="ll-body" style="font-size:17px;margin-bottom:clamp(30px,4vw,48px)">
        Nous partons du travail que vous voulez simplifier et des personnes qui utiliseront le
        logiciel. Voici quelques exemples de besoins que nous pouvons étudier ensemble.
      </p>
    </div>
    <div class="ll-wrap" style="padding-bottom:clamp(38px,5vw,60px)">
      <div class="ll-rows ll-rows--open">
        {questions.map((item, i) => (
          <div class="ll-row ll-row--q">
            <div class="ll-row__ask">
              <span class="ll-row__asknum">{String(i + 1).padStart(2, "0")}</span>
              <span class="ll-row__asktext" set:html={item.q} />
            </div>
            <p class="ll-row__a" style="align-self:center" set:html={item.a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionBar
    id="offres"
    label="02 · Les offres"
    note="Deux points de départ, puis un suivi"
  />

  <section class="ll-sec">
    <div class="ll-wrap">
      <ProjectOffers />
    </div>
  </section>

  <SectionBar label="03 · Le déroulement" note="Le budget de construction et le coût de suivi sont distincts" />

  <section class="ll-sec">
    <div class="ll-wrap ll-pad-lg">
      <div class="ll-intro">
        <h2 class="ll-h2">Construire,<br />puis faire durer.</h2>
        <div class="ll-stack" style="gap:18px;max-width:56ch">
          <p class="ll-body" style="font-size:17px">
            Avant de démarrer, nous précisons le périmètre, la durée estimée et le coût de
            fonctionnement prévu. Vous testez les versions intermédiaires et validez les étapes.
          </p>
          <p class="ll-body" style="font-size:17px">
            À la livraison, la phase de construction se termine. Le suivi prend le relais selon les
            services convenus. Les nouvelles fonctionnalités importantes font l'objet d'un chiffrage.
          </p>
          <a href="/approche" class="ll-btn ll-btn--ghost" style="align-self:flex-start">Voir comment nous travaillons →</a>
        </div>
      </div>
    </div>
  </section>

  <ProofSection
    label="04 · Notre méthode de production"
    title="Un atelier logiciel,<br />avec un suivi humain"
    body="Nous développons nos propres outils d'orchestration d'agents de code. Ils soutiennent la construction et les vérifications. Le cadrage, les décisions techniques et la validation des livraisons restent sous notre responsabilité."
    projects={3}
  />

  <section class="ll-sec">
    <div class="ll-wrap">
      <div class="ll-anchorage">
        <div class="ll-anchorage__text">
          <div class="ll-bar__label">05 — L'ancrage</div>
          <h2 class="ll-h2 ll-h2--tight">Depuis Angers,<br />pour des équipes<br />partout</h2>
          <p class="ll-body" style="font-size:16px;max-width:48ch">
            Nous sommes sur la Loire et nous y restons. Le travail, lui, est à distance par défaut —
            sur site quand ça se justifie. Les PME et collectivités des Pays de la Loire ont accès
            aux mêmes méthodes que les équipes produit que nous accompagnons ailleurs.
          </p>
          <div class="ll-chips" style="margin-top:4px">
            <a href="/ia-angers" class="ll-chip">Agence IA à Angers</a>
            <a href="/ia-angers-pme" class="ll-chip">IA pour PME</a>
          </div>
        </div>
        <div class="ll-anchorage__plot">
          <div class="ll-mono">47.4784 N · −0.5632 E</div>
          <div class="ll-flow" aria-hidden="true">
            {flow.map((h, i) => (
              <span class:list={[i >= 3 && i <= 6 && "on"]} style={`height:${h}%`}></span>
            ))}
          </div>
          <div class="ll-anchorage__caption">
            LA LOIRE — DÉBIT MOYEN<br />ANGERS · PAYS DE LA LOIRE
          </div>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <>
      <SectionBar label="06 · Le blog" note="Voir tous les articles →" noteHref="/blog" />
      <section class="ll-sec">
        <div class="ll-wrap">
          <div class="ll-grid ll-grid--3">
            {posts.map((post) => (
              <a href={`/blog/${post.slug}`} class="ll-cell" style="min-height:230px">
                <div class="ll-mono ll-mono--plain" style="font-size:11px">
                  {formatDate(post.data.date)}
                </div>
                <h3 style="font-weight:700;font-size:19px;line-height:1.18;margin:0;letter-spacing:-.01em">
                  {post.data.title}
                </h3>
                <p>{post.data.excerpt}</p>
                <div class="ll-cell__foot" style="color:var(--cobalt)">
                  <span>Lire →</span>
                  <span>{readingTimeFromBody(post.body)} min</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <CtaBand
    title="Décrivez-nous<br />votre projet"
    body="Ce que vous voulez construire, reprendre ou simplifier. Nous vous aidons à définir une première étape et son budget."
    cta="Décrire mon projet →"
  />
</Base>
