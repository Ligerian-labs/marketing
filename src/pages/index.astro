---
export const prerender = true;
import Base from "../layouts/Base.astro";
import SectionBar from "../components/SectionBar.astro";
import OfferGrid from "../components/OfferGrid.astro";
import DiagnosticTable from "../components/DiagnosticTable.astro";
import ProofSection from "../components/ProofSection.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCollection } from "astro:content";
import { formatDate, readingTimeFromBody } from "../lib/blog";

const posts = (await getCollection("blog"))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const questions = [
  {
    q: "Combien l'IA nous a-t-elle coûté le mois dernier — par fonctionnalité, par client&nbsp;?",
    a: "La plupart des équipes n'ont qu'un seul chiffre : la facture du fournisseur. Il ne se rattache ni à une fonctionnalité, ni à un client, ni à une décision.",
  },
  {
    q: "Le changement de prompt de la semaine dernière a-t-il amélioré ou dégradé le produit&nbsp;?",
    a: "Sans évaluations dans la CI, la qualité est arbitrée par celui qui s'est plaint le plus fort. Vous livrez des régressions invisibles.",
  },
  {
    q: "Que se passe-t-il quand le modèle, le prix ou l'API changent&nbsp;?",
    a: "Si la réponse est «&nbsp;on réécrit&nbsp;», l'IA n'est pas dans votre architecture — elle est scotchée dessus. Chaque changement de fournisseur devient un trimestre non prévu.",
  },
  {
    q: "Quelle part de votre travail pourrait déjà tourner sans humain&nbsp;?",
    a: "Tout le monde a une intuition. Personne n'a d'inventaire — la conversation sur l'automatisation ne dépasse donc jamais l'opinion.",
  },
];

// La Loire, mean flow. Bar heights in %; the cobalt run is the spring rise.
const flow = [34, 52, 44, 68, 88, 100, 76, 58, 41, 30, 24];
---

<Base
  title="Agence IA à Angers — l'IA en production, mesurée et tenue | Ligerian Labs"
  description="Ligerian Labs met l'IA en production et vous rend la main sur ce qu'elle coûte, ce qu'elle fait et si elle s'améliore. Token ops, mise en production, architecture IA, agents. Angers, Pays de la Loire."
  ogImage="og-accueil"
>
  <header class="ll-sec">
    <div class="ll-wrap ll-hero ll-hero--wide">
      <div class="ll-hero__main" style="gap:26px">
        <div class="ll-mono" style="font-size:12px;letter-spacing:.16em">
          Laboratoire IA — Angers, Pays de la Loire
        </div>
        <h1 class="ll-display">
          Votre IA<br />tourne.<br /><span style="white-space:nowrap">Pouvez-vous</span><br />le
          prouver&nbsp;?
        </h1>
        <p class="ll-lede ll-lede--strong">
          Nous mettons l'IA en production et nous vous rendons la main sur ce qu'elle coûte, ce
          qu'elle fait, et si elle s'améliore. Concrètement, mesurable, sans PowerPoint creux.
        </p>
        <div class="ll-btn-row" style="margin-top:6px">
          <a href="/contact" class="ll-btn ll-btn--lg">Parlons de votre projet →</a>
          <a href="/offres" class="ll-btn ll-btn--lg ll-btn--ghost">Voir les offres</a>
        </div>
      </div>

      <div class="ll-hero__aside ll-hero__aside--cobalt" style="gap:28px;min-height:340px">
        <div class="ll-mono" style="color:inherit">Le point de départ</div>
        <div style="display:flex;flex-direction:column;gap:16px">
          <div class="ll-kicker">Deux semaines<br />de cadrage</div>
          <p style="margin:0;font-size:15.5px;line-height:1.55">
            On lit le code, les tableaux de bord et les factures. Vous repartez avec une évaluation
            écrite et un plan séquencé — que vous continuiez avec nous ou non.
          </p>
        </div>
        <a
          href="/offres#cadrage"
          class="ll-btn ll-btn--cream"
          style="align-self:flex-start;padding:15px 24px;font-size:15.5px"
        >
          Le sprint de cadrage →
        </a>
      </div>
    </div>
  </header>

  <SectionBar label="01 — Le problème" note="Posez-les à votre équipe lundi" />

  <section class="ll-sec">
    <div class="ll-wrap" style="padding-top:clamp(38px,5vw,68px)">
      <h2 class="ll-h2" style="margin-bottom:16px">Quatre questions<br />sans réponse</h2>
      <p class="ll-body" style="font-size:17px;margin-bottom:clamp(30px,4vw,48px)">
        Toutes les entreprises que nous rencontrons ont mis quelque chose avec de l'IA en
        production. Presque aucune ne sait répondre aux quatre. C'est dans cet écart que se trouve
        le risque.
      </p>
    </div>
    <div class="ll-wrap" style="padding-bottom:clamp(38px,5vw,60px)">
      <div class="ll-rows ll-rows--open">
        {questions.map((item, i) => (
          <div class="ll-row ll-row--q">
            <div class="ll-row__ask">
              <span class="ll-row__asknum">{String(i + 1).padStart(2, "0")}</span>
              <span class="ll-row__asktext" set:html={item.q} />
            </div>
            <p class="ll-row__a" style="align-self:center" set:html={item.a} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionBar
    id="offres"
    label="02 — Ce que nous vendons"
    note="Quatre offres · vous en achetez une"
  />

  <section class="ll-sec">
    <div class="ll-wrap">
      <OfferGrid />
    </div>
  </section>

  <SectionBar id="diagnostic" label="03 — Diagnostic" note="Trouvez la ligne qui vous ressemble" />

  <section class="ll-sec">
    <div class="ll-wrap ll-pad-lg">
      <div class="ll-intro">
        <h2 class="ll-h2">Où vous en<br />êtes sans doute</h2>
        <p class="ll-body" style="font-size:17px;max-width:56ch">
          Quatre stades, dans l'ordre où les entreprises les traversent réellement. Vous n'achetez
          pas les quatre offres — vous achetez celle qui vous sort du stade où vous êtes.
        </p>
      </div>
      <DiagnosticTable />
    </div>
  </section>

  <ProofSection stats projects={3} />

  <section class="ll-sec">
    <div class="ll-wrap">
      <div class="ll-anchorage">
        <div class="ll-anchorage__text">
          <div class="ll-bar__label">05 — L'ancrage</div>
          <h2 class="ll-h2 ll-h2--tight">Depuis Angers,<br />pour des équipes<br />partout</h2>
          <p class="ll-body" style="font-size:16px;max-width:48ch">
            Nous sommes sur la Loire et nous y restons. Le travail, lui, est à distance par défaut —
            sur site quand ça se justifie. Les PME et collectivités des Pays de la Loire ont accès
            aux mêmes méthodes que les équipes produit que nous accompagnons ailleurs.
          </p>
          <div class="ll-chips" style="margin-top:4px">
            <a href="/ia-angers" class="ll-chip">Agence IA à Angers</a>
            <a href="/ia-angers-pme" class="ll-chip">IA pour PME</a>
          </div>
        </div>
        <div class="ll-anchorage__plot">
          <div class="ll-mono">47.4784 N · −0.5632 E</div>
          <div class="ll-flow" aria-hidden="true">
            {flow.map((h, i) => (
              <span class:list={[i >= 3 && i <= 6 && "on"]} style={`height:${h}%`}></span>
            ))}
          </div>
          <div class="ll-anchorage__caption">
            LA LOIRE — DÉBIT MOYEN<br />ANGERS · PAYS DE LA LOIRE
          </div>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <>
      <SectionBar label="06 — Le blog" note="Voir tous les articles →" noteHref="/blog" />
      <section class="ll-sec">
        <div class="ll-wrap">
          <div class="ll-grid ll-grid--3">
            {posts.map((post) => (
              <a href={`/blog/${post.slug}`} class="ll-cell" style="min-height:230px">
                <div class="ll-mono ll-mono--plain" style="font-size:11px">
                  {formatDate(post.data.date)}
                </div>
                <h3 style="font-weight:700;font-size:19px;line-height:1.18;margin:0;letter-spacing:-.01em">
                  {post.data.title}
                </h3>
                <p>{post.data.excerpt}</p>
                <div class="ll-cell__foot" style="color:var(--cobalt)">
                  <span>Lire →</span>
                  <span>{readingTimeFromBody(post.body)} min</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  <CtaBand
    title="Commencez par<br />deux semaines"
    body="Vous n'avez pas à choisir une offre aujourd'hui. Le sprint de cadrage dit laquelle il vous faut vraiment — et le livrable est à vous dans tous les cas."
  />
</Base>
