---
export const prerender = false;
import { readdirSync } from "node:fs";
import { join } from "node:path";
import Base from "../../../layouts/Base.astro";
import { getAuthenticatedUser } from "../../../lib/auth";
import {
  hasAccess,
  getFormationChapters,
  FORMATION_TIERS,
  resolveFormationTier,
} from "../../../lib/formations";

const { tier } = Astro.params;
const resolvedTier = tier ? resolveFormationTier(tier) : null;

if (!resolvedTier) {
  return Astro.redirect("/formations/", 302);
}

const formation = FORMATION_TIERS[resolvedTier];

const user = await getAuthenticatedUser(Astro.cookies);

if (!user) {
  return Astro.redirect(`/auth/connexion?redirect=/formations/${tier}/`);
}

if (!hasAccess(user.id, formation.tier_dir)) {
  return Astro.redirect("/formations/");
}

const chapters = await getFormationChapters(formation.tier_dir);

// Fallback if chapters can't be read from README.md — scan the directory.
if (chapters.length === 0) {
  try {
    const contentPath = join(process.cwd(), "src", "formations", tier!);
    const files = readdirSync(contentPath)
      .filter((file) => file.endsWith(".md") && file !== "README.md")
      .sort()
      .map((file) => {
        const slug = file.replace(".md", "");
        const title = slug
          .replace(/^\d+-/, "")
          .replace(/-/g, " ")
          .replace(/\b\w/g, (l) => l.toUpperCase());
        return { slug, title };
      });
    chapters.push(...files);
  } catch (error) {
    console.error("Error reading chapter files:", error);
  }
}
---

<Base
  title={`${formation.name} — Formation IA | Ligerian Labs`}
  description={formation.description}
  robots="noindex, nofollow"
>
  <header class="ll-sec">
    <div class="ll-wrap">
      <nav class="ll-crumbs" aria-label="Fil d'Ariane">
        <a href="/formations/">Formations</a><span>/</span><span>{formation.name}</span>
      </nav>
      <div class="ll-pad" style="display:flex;flex-direction:column;gap:16px">
        <div class="ll-mono" style="font-size:12px;letter-spacing:.16em">Formation</div>
        <h1 class="ll-h1" style="font-size:clamp(28px,3.6vw,48px)">{formation.name}</h1>
        <p class="ll-lede">{formation.description}</p>
        {chapters.length > 0 && (
          <div class="ll-mono ll-mono--plain">
            {chapters.length} chapitres · ~{chapters.length * 10} min de lecture
          </div>
        )}
      </div>
    </div>
  </header>

  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      {chapters.length > 0 ? (
        <div class="ll-box" style="padding:0">
          {chapters.map((chapter, index) => (
            <a href={`/formations/${tier}/${chapter.slug}`} class="ll-listrow">
              <div style="display:grid;grid-template-columns:34px 1fr;gap:14px;align-items:baseline">
                <span style="font-family:var(--font-mono);font-size:12px;color:var(--cobalt)">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="ll-listrow__name">{chapter.title}</span>
              </div>
              <span class="ll-mono ll-mono--sm" style="color:var(--cobalt)">Lire →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="ll-note">
          <div class="ll-label">Contenu en préparation</div>
          <p>
            Les chapitres de cette formation seront disponibles très bientôt. Vous serez notifié par
            email dès leur publication.
          </p>
        </div>
      )}

      <div
        style="margin-top:clamp(24px,3vw,38px);display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap"
      >
        <a href="/formations/" class="ll-mono ll-mono--plain">← Toutes les formations</a>
        {chapters.length > 0 && (
          <a href={`/formations/${tier}/${chapters[0].slug}`} class="ll-btn">
            Commencer la formation →
          </a>
        )}
      </div>
    </div>
  </section>
</Base>
