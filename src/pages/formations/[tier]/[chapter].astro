---
export const prerender = false;
import Base from "../../../layouts/Base.astro";
import { getAuthenticatedUser } from "../../../lib/auth";
import {
  hasAccess,
  getFormationContent,
  getFormationChapters,
  FORMATION_TIERS,
  resolveFormationTier,
} from "../../../lib/formations";
import { marked } from "marked";

const { tier, chapter } = Astro.params;
const resolvedTier = tier ? resolveFormationTier(tier) : null;

if (!resolvedTier || !chapter) {
  return Astro.redirect("/formations/", 302);
}

const formation = FORMATION_TIERS[resolvedTier];

const user = await getAuthenticatedUser(Astro.cookies);

if (!user) {
  return Astro.redirect(`/auth/connexion?redirect=/formations/${tier}/${chapter}`);
}

if (!hasAccess(user.id, formation.tier_dir)) {
  return Astro.redirect("/formations/");
}

const content = await getFormationContent(formation.tier_dir, chapter);

if (!content) {
  return Astro.redirect(`/formations/${tier}/`);
}

// Get all chapters for prev/next navigation
const chapters = await getFormationChapters(formation.tier_dir);
const currentIndex = chapters.findIndex((c) => c.slug === chapter);
const prevChapter = currentIndex > 0 ? chapters[currentIndex - 1] : null;
const nextChapter = currentIndex < chapters.length - 1 ? chapters[currentIndex + 1] : null;

// Slugify helper — consistent between TOC and renderer
function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/\*\*/g, "")
    .replace(/[^a-zà-ÿ0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .replace(/(^-|-$)/g, "");
}

// Extract TOC from h2/h3 headings
const tocEntries: Array<{ id: string; text: string; level: number }> = [];
const headingRegex = /^(#{2,3})\s+(.+)$/gm;
let match;
while ((match = headingRegex.exec(content)) !== null) {
  const level = match[1].length;
  const text = match[2].replace(/\*\*/g, "");
  tocEntries.push({ id: slugify(text), text, level });
}

// Custom renderer to inject matching IDs on headings (marked v17+ API)
marked.use({
  renderer: {
    heading({ tokens, depth }: { tokens: any[]; depth: number }) {
      // @ts-ignore — marked internal parser
      const text = (this as any).parser.parseInline(tokens);
      const clean = text.replace(/<[^>]+>/g, "").replace(/\*\*/g, "");
      return `<h${depth} id="${slugify(clean)}">${text}</h${depth}>\n`;
    },
  },
});

const htmlContent = marked(content, { breaks: true, gfm: true });

// Extract title
let title = chapter
  .replace(/^\d+-/, "")
  .replace(/-/g, " ")
  .replace(/\b\w/g, (l) => l.toUpperCase());
const titleMatch = content.match(/^#\s+(.+)$/m);
if (titleMatch) title = titleMatch[1];

// Estimate reading time (~200 words/min for French)
const wordCount = content.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<Base
  title={`${title} — ${formation.name} | Ligerian Labs`}
  description={`Chapitre « ${title} » de la formation « ${formation.name} »`}
  robots="noindex, nofollow"
>
  <div id="progress-bar"></div>

  <header class="ll-sec">
    <div class="ll-wrap">
      <nav class="ll-crumbs" aria-label="Fil d'Ariane">
        <a href="/formations/">Formations</a><span>/</span>
        <a href={`/formations/${tier}/`}>{formation.name}</a><span>/</span>
        <span>{title}</span>
      </nav>
      <div class="ll-pad" style="display:flex;flex-direction:column;gap:14px">
        {chapters.length > 0 && (
          <div class="ll-mono ll-mono--cobalt" style="font-size:11.5px;letter-spacing:.16em">
            Chapitre {currentIndex + 1} sur {chapters.length}
          </div>
        )}
        <h1 class="ll-h1" style="font-size:clamp(26px,3.4vw,44px)">{title}</h1>
        <div class="ll-mono ll-mono--plain">
          {readingTime} min de lecture · {wordCount.toLocaleString("fr-FR")} mots
        </div>
      </div>
    </div>
  </header>

  <section class="ll-sec">
    <div class="ll-wrap">
      <div class="ll-article">
        <article class="ll-article__body ll-prose">
          <Fragment set:html={htmlContent} />

          <nav class="ll-chapnav">
            {prevChapter ? (
              <a href={`/formations/${tier}/${prevChapter.slug}`} class="ll-chapnav__link">
                <span class="ll-label">← Précédent</span>
                <b>{prevChapter.title}</b>
              </a>
            ) : (
              <a href={`/formations/${tier}/`} class="ll-chapnav__link">
                <span class="ll-label">←</span>
                <b>Sommaire</b>
              </a>
            )}
            {nextChapter ? (
              <a
                href={`/formations/${tier}/${nextChapter.slug}`}
                class="ll-chapnav__link ll-chapnav__link--end"
              >
                <span class="ll-label">Suivant →</span>
                <b>{nextChapter.title}</b>
              </a>
            ) : (
              <a
                href={`/formations/${tier}/`}
                class="ll-chapnav__link ll-chapnav__link--end ll-chapnav__link--done"
              >
                <span class="ll-label" style="color:inherit">Formation terminée</span>
                <b>Retour au sommaire</b>
              </a>
            )}
          </nav>
        </article>

        {tocEntries.length > 2 && (
          <aside class="ll-article__aside">
            <div class="ll-article__sticky">
              <div style="display:flex;flex-direction:column;gap:9px">
                <span class="ll-label">Sur cette page</span>
                <nav class="ll-chaptoc">
                  {tocEntries.map((entry) => (
                    <a
                      href={`#${entry.id}`}
                      data-toc-link={entry.id}
                      class:list={[entry.level === 3 && "ll-chaptoc__sub"]}
                    >
                      {entry.text}
                    </a>
                  ))}
                </nav>
              </div>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>
</Base>

<style is:global>
  #progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--cobalt);
    z-index: 100;
    transition: width 0.15s linear;
  }

  .ll-chaptoc {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
  }

  .ll-chaptoc a {
    font-size: 14px;
    line-height: 1.4;
    padding: 5px 0;
    color: var(--ink);
  }

  .ll-chaptoc a:hover,
  .ll-chaptoc a.active {
    color: var(--cobalt);
  }

  .ll-chaptoc__sub {
    padding-left: 14px;
    color: var(--meta) !important;
    font-size: 13.5px;
  }

  .ll-chapnav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--ink);
    border: 2px solid var(--ink);
    margin-top: clamp(34px, 4vw, 56px);
  }

  .ll-chapnav__link {
    background: var(--cream);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--ink);
  }

  .ll-chapnav__link:hover {
    background: var(--panel);
    color: var(--ink);
  }

  .ll-chapnav__link b {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
  }

  .ll-chapnav__link--end {
    text-align: right;
    align-items: flex-end;
  }

  .ll-chapnav__link--done {
    background: var(--cobalt);
    color: var(--cream);
  }

  .ll-chapnav__link--done:hover {
    background: var(--ink);
    color: var(--cream);
  }

  @media (max-width: 620px) {
    .ll-chapnav {
      grid-template-columns: 1fr;
    }

    .ll-chapnav__link--end {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>

<script is:inline>
  // Reading progress bar
  const bar = document.getElementById("progress-bar");
  if (bar) {
    window.addEventListener(
      "scroll",
      () => {
        const h = document.documentElement;
        const pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
        bar.style.width = Math.min(100, pct) + "%";
      },
      { passive: true },
    );
  }

  // Highlight active TOC link on scroll
  const tocLinks = document.querySelectorAll("[data-toc-link]");
  if (tocLinks.length > 0) {
    const headings = Array.from(tocLinks)
      .map((link) => ({ link, el: document.getElementById(link.getAttribute("data-toc-link")) }))
      .filter((h) => h.el);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tocLinks.forEach((l) => l.classList.remove("active"));
            const match = headings.find((h) => h.el === entry.target);
            if (match) match.link.classList.add("active");
          }
        });
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );

    headings.forEach((h) => observer.observe(h.el));
  }
</script>
