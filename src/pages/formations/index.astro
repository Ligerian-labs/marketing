---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getAuthenticatedUser } from "../../lib/auth";
import { getUserPurchases } from "../../lib/formations";

const user = getAuthenticatedUser(Astro.cookies);
const purchases = user ? getUserPurchases(user.id) : [];

// Never start checkout from a GET URL: crawlers can follow links and create
// unwanted Stripe sessions. Checkout starts from POST /api/stripe/checkout.
const buyPack = Astro.url.searchParams.get("buy");
if (buyPack && ["formation-starter", "formation-intermediate", "formation-premium"].includes(buyPack)) {
  return Astro.redirect("/formations/", 301);
}

const formations = [
  {
    id: "formation-starter",
    name: "IA pour les PME",
    label: "F/01 · Starter",
    description: "Comprendre l'IA et lancer votre premier projet en 30 jours.",
    price: 49,
    tier_dir: "01-guide-pme",
    popular: false,
    chapters: 6,
    features: [
      "Comprendre l'IA sans jargon",
      "Cas d'usage concrets pour PME",
      "Outils no-code recommandés",
      "Premier projet IA pas à pas",
      "Erreurs à éviter",
    ],
  },
  {
    id: "formation-intermediate",
    name: "Automatiser son business",
    label: "F/02 · Intermédiaire",
    description: "Construire des workflows IA qui tournent en continu.",
    price: 99,
    tier_dir: "02-automatiser",
    popular: true,
    chapters: 8,
    features: [
      "Tout le contenu Starter inclus",
      "Stack IA moderne (LLMs, APIs, RAG)",
      "Automatiser marketing & ventes",
      "Workflows Make.com & n8n",
      "Plan d'action 90 jours",
    ],
  },
  {
    id: "formation-premium",
    name: "Déployer l'IA en entreprise",
    label: "F/03 · Premium",
    description: "Architecture, gouvernance et mise en production à l'échelle.",
    price: 149,
    tier_dir: "03-deployer",
    popular: false,
    chapters: 9,
    features: [
      "Tout le contenu précédent inclus",
      "Architecture technique avancée",
      "LLMs en production",
      "Gouvernance, sécurité & EU AI Act",
      "5 cas d'études détaillés",
    ],
  },
];

const hasPurchased = (formationId: string) =>
  purchases.some((p) => p.pack === formationId && p.status === "completed");

const payment = Astro.url.searchParams.get("payment");
const setup = Astro.url.searchParams.get("setup");
---

<Base
  title="Formations IA — Ligerian Labs"
  description="Formations pratiques pour intégrer l'intelligence artificielle dans votre entreprise, du premier cas d'usage à la mise en production."
  robots="index, follow"
>
  {payment === "success" && (
    <div class="ll-notice">
      <div class="ll-wrap"><p>Paiement réussi. Votre formation est accessible ci-dessous.</p></div>
    </div>
  )}
  {setup === "success" && (
    <div class="ll-notice">
      <div class="ll-wrap"><p>Compte configuré. Vos formations vous attendent ci-dessous.</p></div>
    </div>
  )}
  {payment === "cancelled" && (
    <div class="ll-notice ll-notice--muted">
      <div class="ll-wrap"><p>Paiement annulé. Vous pouvez réessayer quand vous le souhaitez.</p></div>
    </div>
  )}

  <header class="ll-sec">
    <div class="ll-wrap ll-hero">
      <div class="ll-hero__main">
        <div class="ll-mono" style="font-size:12px;letter-spacing:.16em">Formations</div>
        <h1 class="ll-h1">Maîtrisez l'IA<br />pour votre<br />entreprise</h1>
        <p class="ll-lede">
          Trois parcours pratiques, du premier cas d'usage à la mise en production. Écrits depuis
          des missions réelles — même méthode, format autonome.
        </p>
      </div>
      <div class="ll-hero__aside ll-hero__aside--panel">
        <div class="ll-mono">Format</div>
        <div class="ll-bullets" style="font-size:15px">
          <div class="ll-bullet"><span>Chapitres courts, lisibles en une session</span></div>
          <div class="ll-bullet"><span>Exemples et gabarits réutilisables</span></div>
          <div class="ll-bullet"><span>Accès à vie, mises à jour incluses</span></div>
        </div>
        <div class="ll-mono ll-mono--plain">Paiement unique · sans abonnement</div>
      </div>
    </div>
  </header>

  <section class="ll-sec">
    <div class="ll-wrap">
      <div class="ll-grid ll-grid--3">
        {formations.map((formation) => {
          const purchased = hasPurchased(formation.id);
          return (
            <div class:list={["ll-cell", "ll-price", formation.popular && "ll-cell--cobalt"]}>
              <div class="ll-price__label">{formation.label}</div>
              <h2 class="ll-offer__name" style="font-size:21px">{formation.name}</h2>
              <p style="margin-top:10px">{formation.description}</p>

              <div class="ll-price__amount">{formation.price} €</div>
              <div class="ll-price__unit">{formation.chapters} chapitres · accès à vie</div>

              <div
                class="ll-bullets"
                style="margin-top:22px;padding-top:18px;border-top:1px solid var(--rule-hair);font-size:14.5px"
              >
                {formation.features.map((feature) => (
                  <div class:list={["ll-bullet", formation.popular && "ll-bullet--cream"]}>
                    <span>{feature}</span>
                  </div>
                ))}
              </div>

              <div class="ll-price__cta">
                {purchased ? (
                  <a
                    href={`/formations/${formation.tier_dir}/`}
                    class:list={["ll-btn", "ll-btn--block", formation.popular && "ll-btn--cream"]}
                  >
                    Accéder au contenu →
                  </a>
                ) : (
                  <form action="/api/stripe/checkout" method="POST">
                    <input type="hidden" name="pack" value={formation.id} />
                    <button
                      type="submit"
                      class:list={[
                        "ll-btn",
                        "ll-btn--block",
                        formation.popular ? "ll-btn--cream" : "ll-btn--ghost",
                      ]}
                    >
                      Acheter
                    </button>
                  </form>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {!user && (
        <p style="padding:22px 0;text-align:center" class="ll-mono ll-mono--plain">
          Déjà un compte&nbsp;?
          <a href="/auth/connexion?redirect=/formations/">Se connecter</a>
        </p>
      )}
    </div>
  </section>

  <CtaBand
    title="Vous préférez<br />qu'on le fasse&nbsp;?"
    body="Les formations transmettent la méthode. Les quatre offres la mettent en œuvre chez vous, en production."
    cta="Voir les offres →"
    href="/offres"
  />
</Base>
