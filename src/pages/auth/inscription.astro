---
export const prerender = false;
import AuthSplit from "../../layouts/AuthSplit.astro";
import { getUserByEmail, createUser, createSession, setSessionCookie } from "../../lib/auth";

const redirectTo = Astro.url.searchParams.get("redirect") || "/dashboard";
let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = formData.get("email") as string;
  const name = formData.get("name") as string;
  const company = formData.get("company") as string;
  const password = formData.get("password") as string;
  const confirmPassword = formData.get("confirm_password") as string;
  const redirect = (formData.get("redirect") as string) || redirectTo;

  if (!email || !name || !password) {
    error = "Nom, email et mot de passe requis.";
  } else if (password.length < 8) {
    error = "Le mot de passe doit contenir au moins 8 caractères.";
  } else if (password !== confirmPassword) {
    error = "Les mots de passe ne correspondent pas.";
  } else {
    const existing = getUserByEmail(email);
    if (existing) {
      error = "Un compte avec cet email existe déjà.";
    } else {
      try {
        const user = createUser(email, password, name, company || undefined);
        const sessionId = createSession(user.id);
        setSessionCookie(Astro.cookies, sessionId);
        return Astro.redirect(redirect);
      } catch {
        error = "Erreur lors de la création du compte. Réessayez.";
      }
    }
  }
}

const loginHref = `/auth/connexion${redirectTo !== "/dashboard" ? `?redirect=${encodeURIComponent(redirectTo)}` : ""}`;
---

<AuthSplit
  title="Créer un compte — espace client | Ligerian Labs"
  kicker="Inscription"
  heading="Créer un compte"
>
  <input type="hidden" name="redirect" value={redirectTo} />

  {error && (
    <div class="ll-alert ll-alert--err" role="alert">
      <p>{error}</p>
    </div>
  )}

  <label class="ll-field">
    <span class="ll-label">Nom complet</span>
    <input class="ll-input" type="text" name="name" required placeholder="Prénom et nom" autocomplete="name" />
  </label>

  <label class="ll-field">
    <span class="ll-label">Email</span>
    <input class="ll-input" type="email" name="email" required placeholder="vous@entreprise.fr" autocomplete="email" />
  </label>

  <label class="ll-field">
    <span class="ll-label">Entreprise (optionnel)</span>
    <input class="ll-input" type="text" name="company" placeholder="Nom de la structure" autocomplete="organization" />
  </label>

  <label class="ll-field">
    <span class="ll-label">Mot de passe</span>
    <input
      class="ll-input"
      type="password"
      name="password"
      required
      minlength="8"
      placeholder="••••••••"
      autocomplete="new-password"
    />
    <span class="ll-mono ll-mono--plain" style="font-size:11px">Minimum 8 caractères</span>
  </label>

  <label class="ll-field">
    <span class="ll-label">Confirmer le mot de passe</span>
    <input
      class="ll-input"
      type="password"
      name="confirm_password"
      required
      placeholder="••••••••"
      autocomplete="new-password"
    />
  </label>

  <button type="submit" class="ll-btn ll-btn--lg ll-btn--block">Créer mon compte →</button>

  <div
    style="border-top:1px solid var(--rule-hair);padding-top:18px;font-size:14.5px;line-height:1.55;color:var(--ink-soft)"
  >
    Déjà un compte&nbsp;? <a href={loginHref}>Se connecter</a>.
  </div>
</AuthSplit>
