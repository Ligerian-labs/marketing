---
export const prerender = false;
import AuthSplit from "../../layouts/AuthSplit.astro";
import { getUserByEmail, createPasswordToken } from "../../lib/auth";
import { sendPasswordResetEmail } from "../../lib/email";

let sent = false;
let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = formData.get("email")?.toString()?.trim();

  if (!email) {
    error = "Veuillez entrer votre adresse email.";
  } else {
    // Always show success to prevent email enumeration
    sent = true;

    const user = getUserByEmail(email);
    if (user) {
      try {
        const token = createPasswordToken(user.id);
        await sendPasswordResetEmail(email, user.name, token);
        console.log(`[AUTH] Password reset email sent to ${email}`);
      } catch (err) {
        console.error(`[AUTH] Failed to send reset email to ${email}:`, err);
      }
    }
  }
}
---

<AuthSplit
  title="Mot de passe oublié | Ligerian Labs"
  kicker="Réinitialisation"
  heading="Mot de passe oublié"
>
  {error && (
    <div class="ll-alert ll-alert--err" role="alert">
      <p>{error}</p>
    </div>
  )}

  {sent ? (
    <div class="ll-alert ll-alert--ok" role="status">
      <div class="ll-mono" style="color:inherit">Email envoyé</div>
      <p>
        Si un compte existe avec cette adresse, vous recevrez un lien de réinitialisation d'ici
        quelques minutes.
      </p>
    </div>
  ) : (
    <>
      <p style="margin:0;font-size:15.5px;line-height:1.55;color:var(--ink-soft)">
        Entrez l'adresse de votre compte. Nous vous envoyons un lien pour choisir un nouveau mot de
        passe.
      </p>

      <label class="ll-field">
        <span class="ll-label">Email</span>
        <input class="ll-input" type="email" name="email" required placeholder="vous@entreprise.fr" autocomplete="email" />
      </label>

      <button type="submit" class="ll-btn ll-btn--lg ll-btn--block">Envoyer le lien →</button>
    </>
  )}

  <div
    style="border-top:1px solid var(--rule-hair);padding-top:18px;font-size:14.5px;line-height:1.55;color:var(--ink-soft)"
  >
    <a href="/auth/connexion">← Retour à la connexion</a>
  </div>
</AuthSplit>
