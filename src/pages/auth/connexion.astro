---
export const prerender = false;
import AuthSplit from "../../layouts/AuthSplit.astro";
import { getUserByEmail, verifyPassword, createSession, setSessionCookie } from "../../lib/auth";

const redirectTo = Astro.url.searchParams.get("redirect") || "/dashboard";
let error = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const email = formData.get("email") as string;
  const password = formData.get("password") as string;
  const redirect = (formData.get("redirect") as string) || redirectTo;

  if (!email || !password) {
    error = "Email et mot de passe requis.";
  } else {
    const user = getUserByEmail(email);
    if (!user || !verifyPassword(password, user.password_hash)) {
      error = "Identifiants non reconnus. Vérifiez votre email et votre mot de passe.";
    } else {
      const sessionId = createSession(user.id);
      setSessionCookie(Astro.cookies, sessionId);
      return Astro.redirect(redirect);
    }
  }
}

const signupHref = `/auth/inscription${redirectTo !== "/dashboard" ? `?redirect=${encodeURIComponent(redirectTo)}` : ""}`;
---

<AuthSplit title="Connexion — espace client | Ligerian Labs" kicker="Connexion" heading="Bon retour">
  <input type="hidden" name="redirect" value={redirectTo} />

  {error && (
    <div class="ll-alert ll-alert--err" role="alert">
      <p>{error}</p>
    </div>
  )}

  <label class="ll-field">
    <span class="ll-label">Email</span>
    <input class="ll-input" type="email" name="email" required placeholder="vous@entreprise.fr" autocomplete="email" />
  </label>

  <label class="ll-field">
    <span class="ll-label">Mot de passe</span>
    <input class="ll-input" type="password" name="password" required placeholder="••••••••" autocomplete="current-password" />
  </label>

  <div style="display:flex;justify-content:flex-end;align-items:center;gap:14px;flex-wrap:wrap">
    <a href="/auth/mot-de-passe-oublie" style="font-size:14px">Mot de passe oublié&nbsp;?</a>
  </div>

  <button type="submit" class="ll-btn ll-btn--lg ll-btn--block">Se connecter →</button>

  <div
    style="border-top:1px solid var(--rule-hair);padding-top:18px;font-size:14.5px;line-height:1.55;color:var(--ink-soft)"
  >
    Pas encore de compte&nbsp;? <a href={signupHref}>Créer un compte</a>. L'accès est ouvert au
    démarrage d'une mission — sinon,
    <a href="/contact">parlons de votre projet</a>.
  </div>
</AuthSplit>
