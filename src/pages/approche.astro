---
export const prerender = true;
import Base from "../layouts/Base.astro";
import MarketingFrame from "../components/MarketingFrame.astro";
import SectionBar from "../components/SectionBar.astro";
import CtaBand from "../components/CtaBand.astro";

const method = [
  { n: "01", title: "Définir le besoin", body: "Nous précisons les utilisateurs, le travail à simplifier et les fonctionnalités de la première version. Pour une reprise, nous examinons aussi le code, les données et les accès existants.", foot: "Un périmètre et un budget cible" },
  { n: "02", title: "Construire et tester", body: "Nous construisons par étapes. Vous essayez les versions intermédiaires et validez les priorités. Les changements de périmètre sont discutés avant d'engager la suite.", foot: "2 000 € par mois de construction" },
  { n: "03", title: "Mettre en service", body: "Nous vérifions les parcours convenus, préparons le déploiement et documentons le fonctionnement. La livraison marque la fin de la phase de construction définie ensemble.", foot: "Une livraison validée ensemble" },
  { n: "04", title: "Assurer le suivi", body: "L'hébergement et la maintenance prennent le relais selon l'abonnement convenu. Les demandes d'évolution sont priorisées dans l'enveloppe prévue ou font l'objet d'un nouveau chiffrage.", foot: "Un abonnement adapté au logiciel" },
];

const principles = [
  { title: "Un coût de construction et un coût de suivi", body: "La mensualité de construction, sa durée estimée et le tarif de suivi prévu sont précisés avant le démarrage. Les services externes et leurs coûts sont identifiés dans la proposition." },
  { title: "Conserver ce qui fonctionne", body: "Un logiciel existant n'a pas à être réécrit par défaut. Nous examinons les possibilités de reprise avant de recommander une reconstruction." },
  { title: "Des évolutions avec un périmètre", body: "La maintenance et l'ajout de fonctionnalités répondent à des besoins différents. L'abonnement précise les interventions couvertes et l'enveloppe d'évolutions disponible." },
  { title: "Une documentation pour la suite", body: "Nous documentons le fonctionnement et les opérations nécessaires pour exploiter le logiciel. Les conditions d'accès au code, aux données et de passation sont précisées dans la proposition." },
];
---

<Base
  title="Notre méthode · du besoin au suivi de votre logiciel | Ligerian Labs"
  description="Cadrage, construction par étapes, mise en service et suivi. Un périmètre, une durée estimée et un budget définis avant de démarrer votre logiciel."
  ogTitle="Du besoin au suivi de votre logiciel"
  ogDescription="Un budget de construction clair, des versions à tester et un suivi défini avant le démarrage."
  ogImage="og-approche"
  active="approche"
>
  <MarketingFrame>
  <header class="ll-sec">
    <div class="ll-wrap ll-hero">
      <div class="ll-hero__main">
        <div class="ll-mono">Notre méthode</div>
        <h1 class="ll-h1">Du besoin<br />au logiciel.<br />Puis au suivi.</h1>
        <p class="ll-lede">Nous définissons une première version utile, la construisons par étapes et préparons son fonctionnement après livraison.</p>
      </div>
      <div class="ll-hero__aside ll-hero__aside--panel">
        <div class="ll-mono">Avant de commencer</div>
        <p class="ll-lede">Vous connaissez le périmètre initial, la durée estimée, le budget de construction et le tarif de suivi prévu.</p>
        <a href="/offres/#budget" class="ll-btn ll-btn--ghost" style="align-self:flex-start">Voir les tarifs →</a>
      </div>
    </div>
  </header>

  <SectionBar label="01 · Le déroulement" note="Une première version, puis un suivi dans la durée" />
  <section class="ll-sec">
    <div class="ll-wrap">
      <div class="ll-grid ll-grid--4">
        {method.map((step) => (
          <div class="ll-cell ll-step">
            <div class="ll-step__num">{step.n}</div>
            <h2 class="ll-h3">{step.title}</h2>
            <p style="font-size:16px">{step.body}</p>
            <div class="ll-cell__foot"><span>{step.foot}</span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionBar label="02 · Notre atelier logiciel" note="L'IA dans la production, selon votre besoin dans le produit" />
  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      <div class="ll-intro">
        <h2 class="ll-h2">Un interlocuteur<br />du cadrage<br />au suivi.</h2>
        <div class="ll-stack" style="gap:18px;max-width:56ch">
          <p class="ll-body" style="font-size:17px">Vous testez les versions intermédiaires avec votre équipe. Nous restons votre interlocuteur pour le cadrage, le développement et la validation des livraisons.</p>
          <p class="ll-body" style="font-size:17px">Votre logiciel peut utiliser de l'IA si cela répond au besoin. Il peut aussi être une application de gestion ou un espace client sans fonctionnalité IA.</p>
          <a href="/expertise/" class="ll-btn ll-btn--ghost" style="align-self:flex-start">Découvrir notre expertise IA →</a>
        </div>
      </div>
    </div>
  </section>

  <SectionBar label="03 · Nos engagements" note="Des modalités définies avant les travaux" />
  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      <div class="ll-rows">
        {principles.map((principle, i) => (
          <div class="ll-row ll-row--principle">
            <div class="ll-row__index">{String(i + 1).padStart(2, "0")}</div>
            <h2 class="ll-h3">{principle.title}</h2>
            <p class="ll-row__a">{principle.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title="Quelle première<br />étape pour vous ?" body="Présentez-nous le travail à simplifier ou le logiciel à reprendre. Nous précisons ensemble la suite et son budget." cta="Décrire mon projet →" />
  </MarketingFrame>
</Base>
