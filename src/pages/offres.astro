---
export const prerender = true;
import Base from "../layouts/Base.astro";
import MarketingFrame from "../components/MarketingFrame.astro";
import SectionBar from "../components/SectionBar.astro";
import CtaBand from "../components/CtaBand.astro";
import ProjectCards from "../components/ProjectCards.astro";
import { projectOffers } from "../data/project-offers";
import { offers } from "../data/offers";

const serviceSchema = projectOffers.map((offer) => ({
  "@type": "Service",
  "@id": `https://ligerianlabs.fr/offres/#${offer.slug}`,
  name: offer.name,
  description: offer.description,
  provider: { "@id": "https://ligerianlabs.fr/#organization" },
  areaServed: { "@type": "Country", name: "France" },
}));

const faq = [
  {
    q: "2 000 € par mois, pendant combien de temps ?",
    a: "La durée dépend du périmètre. Avant de démarrer, nous définissons une première version, une durée estimée et un budget cible. À titre d'exemple, trois mois de construction représentent 6 000 €, hors abonnement de suivi et services externes convenus.",
  },
  {
    q: "Le diagnostic est-il compris ?",
    a: "Les modalités du cadrage sont précisées dans la proposition. Si un diagnostic distinct est nécessaire, son périmètre et son prix vous sont communiqués avant de le lancer.",
  },
  {
    q: "Peut-on reprendre un logiciel créé par quelqu'un d'autre ?",
    a: "Oui, après examen du code, des accès et de son fonctionnement. Nous proposons de conserver, corriger ou reconstruire les parties nécessaires. La reprise n'impose pas une réécriture complète.",
  },
  {
    q: "Que couvre l'abonnement après livraison ?",
    a: "La proposition précise l'hébergement, les sauvegardes, la maintenance, les modalités de support et l'enveloppe d'évolutions. Les consommations de services externes, notamment les API IA, sont identifiées séparément. Le tarif dépend de ces besoins.",
  },
  {
    q: "Et si je veux ajouter des fonctionnalités ?",
    a: "Les évolutions entrent dans l'enveloppe convenue pour le suivi. Un ajout plus important fait l'objet d'un chiffrage ou d'une nouvelle phase de construction, avec votre accord avant les travaux.",
  },
  {
    q: "Mon logiciel doit-il utiliser de l'IA ?",
    a: "Non. Nous utilisons l'IA lorsque le besoin le justifie. Une application de gestion, un espace client ou un site peuvent fonctionner sans fonctionnalité IA.",
  },
];
---

<Base
  title="Offres et tarifs · création, reprise et suivi de logiciels | Ligerian Labs"
  description="Construction à 2 000 € par mois, reprise après diagnostic, puis abonnement adapté pour l'hébergement et la maintenance. Périmètre et budget définis avant de démarrer."
  ogTitle="Créer, reprendre et maintenir votre logiciel"
  ogDescription="2 000 € par mois pendant la construction. Reprise sur devis et abonnement de suivi adapté après livraison."
  ogImage="og-offres"
  active="offres"
  structuredData={serviceSchema}
>
  <MarketingFrame>
  <header class="ll-sec">
    <div class="ll-wrap ll-hero">
      <div class="ll-hero__main">
        <div class="ll-mono">Offres et tarifs</div>
        <h1 class="ll-h1">Votre projet.<br />Ses étapes.<br />Son budget.</h1>
        <p class="ll-lede">
          Nous créons votre logiciel ou reprenons votre existant. Après livraison, un abonnement
          adapté assure son hébergement, sa maintenance et les évolutions convenues.
        </p>
      </div>
      <div class="ll-hero__aside ll-hero__aside--cobalt">
        <div class="ll-mono" style="color:inherit">Pendant la construction</div>
        <div class="ll-kicker">2 000 €<br />par mois</div>
        <p style="font-size:17px;line-height:1.5;margin:0">
          Le périmètre initial, la durée estimée et le budget cible sont définis avant de démarrer.
          Le suivi après livraison est chiffré séparément.
        </p>
        <a href="#budget" class="ll-btn ll-btn--cream" style="align-self:flex-start">Comprendre le budget →</a>
      </div>
    </div>
  </header>

  <SectionBar label="01 · Votre point de départ" note="Création ou reprise, puis suivi après livraison" />
  <section class="ll-sec">
    <nav class="ll-wrap ll-pad" aria-label="Les offres">
      <div class="ll-btn-row">
        {projectOffers.map((offer) => <a class="ll-btn ll-btn--ghost" href={`#${offer.slug}`}>{offer.name} ↓</a>)}
      </div>
    </nav>
  </section>

  {projectOffers.map((offer) => (
    <section id={offer.slug} class="ll-sec ll-anchor">
      <div class="ll-wrap">
        <div class="ll-offerbar"><span>{offer.step}</span><span>{offer.price} · {offer.period}</span></div>
        <div class="ll-offerbody">
          <div class="ll-offerbody__left">
            <h2 class="ll-h2 ll-h2--tight">{offer.name}</h2>
            <p class="ll-lede">{offer.description}</p>
            <a href={`/contact/?projet=${offer.slug}`} class="ll-btn" style="align-self:flex-start">{offer.cta} →</a>
          </div>
          <div class="ll-stack">
            <div class="ll-offerbody__deliv">
              <div class="ll-mono" style="margin-bottom:18px">Ce que nous définissons ensemble</div>
              <ul class="project-inclusions">
                {offer.features.map((feature) => <li>{feature}</li>)}
              </ul>
            </div>
            <div class="ll-offerbody__extra"><p class="ll-body">{offer.note}</p></div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <SectionBar id="budget" label="02 · Comprendre le budget" note="Deux phases tarifaires" />
  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      <div class="ll-intro">
        <h2 class="ll-h2">Construire,<br />puis maintenir.</h2>
        <div class="ll-stack" style="gap:18px;max-width:58ch">
          <p class="ll-body" style="font-size:17px">
            Trois mois de construction représentent par exemple 6 000 €. C'est une illustration,
            pas une durée promise pour tous les projets. Nous estimons la durée à partir du
            périmètre convenu et faisons le point aux jalons de validation.
          </p>
          <p class="ll-body" style="font-size:17px">
            Une fois cette phase terminée, un abonnement mensuel de suivi distinct prend le relais.
            Son tarif est défini selon les ressources, la criticité du logiciel et le niveau de
            suivi. Vous connaissez le montant prévu et les services inclus avant de démarrer.
          </p>
          <p class="ll-body">
            Un site de présentation et une application métier utilisée chaque jour n'ont pas les
            mêmes besoins d'exploitation. Le suivi est donc chiffré pour votre projet.
          </p>
        </div>
      </div>
    </div>
  </section>

  <SectionBar id="cadrage" label="03 · Questions fréquentes" note="Avant de démarrer" />
  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      <div class="ll-rows">
        {faq.map((item) => (
          <div class="ll-row">
            <h2 class="ll-h3">{item.q}</h2>
            <p class="ll-row__a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionBar label="04 · Expertise IA" note="Pour les besoins techniques spécialisés" noteHref="/expertise/" />
  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      <p class="ll-body" style="margin-bottom:24px">
        Vous cherchez une intervention ciblée sur un produit IA ? Retrouvez nos domaines
        d'expertise et leurs modalités de mission.
      </p>
      <div class="ll-grid ll-grid--4 ll-grid--boxed">
        {offers.map((offer) => (
          <a id={offer.slug} href={`/expertise/#${offer.slug}`} class="ll-cell ll-anchor">
            <h2 class="ll-h3">{offer.promise}</h2>
            <p>{offer.short}</p>
            <div class="ll-cell__foot"><span>Voir l'expertise →</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SectionBar label="05 · Des projets à examiner" note="Voir les réalisations →" noteHref="/realisations/" />
  <section class="ll-sec"><div class="ll-wrap marketing-section">
    <h2 class="ll-h2">Deux projets indépendants en développement</h2>
    <p class="marketing-intro">Examinez le code disponible et les limites de chaque prototype. Ces travaux ne sont pas des références clients.</p>
    <ProjectCards />
  </div></section>
  <CtaBand title="Parlons de<br />votre logiciel" body="Décrivez le besoin, l'existant et vos priorités. Nous vous proposons une première étape avec un périmètre et un budget." cta="Décrire mon projet →" />
  </MarketingFrame>
</Base>

<style>
  .project-inclusions { margin:0; padding-left:20px; display:grid; gap:18px; font-size:16px; line-height:1.55; }
</style>
