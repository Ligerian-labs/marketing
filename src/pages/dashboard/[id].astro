---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import { getAuthenticatedUser } from "../../lib/auth";
import db from "../../lib/db";

const user = getAuthenticatedUser(Astro.cookies);
if (!user) {
  return Astro.redirect("/auth/connexion");
}

const { id } = Astro.params;
const subscription = db
  .prepare("SELECT * FROM subscriptions WHERE id = ? AND user_id = ?")
  .get(id, user.id) as any;

if (!subscription) {
  return Astro.redirect("/dashboard");
}

const resources = db
  .prepare("SELECT * FROM resources WHERE subscription_id = ? ORDER BY created_at DESC")
  .all(subscription.id) as any[];

const statusSteps = [
  { key: "pending", label: "Commande reçue" },
  { key: "provisioning", label: "Provisionnement" },
  { key: "configuring", label: "Configuration" },
  { key: "testing", label: "Tests" },
  { key: "active", label: "En production" },
];

const currentStepIndex = statusSteps.findIndex((s) => s.key === subscription.status);

const infra = [
  ["Adresse serveur", subscription.server_ip, true],
  ["Fournisseur", subscription.server_provider, false],
  ["Réseau Tailscale", subscription.tailscale_hostname, true],
  ["Version OpenClaw", subscription.openclaw_version && `v${subscription.openclaw_version}`, false],
  [
    "Canal",
    subscription.channel_type &&
      `${subscription.channel_type} — ${subscription.channel_connected ? "connecté" : "en attente"}`,
    false,
  ],
].filter(([, value]) => Boolean(value)) as [string, string, boolean][];
---

<Base title={`${subscription.pack} — Espace client | Ligerian Labs`} robots="noindex, nofollow">
  <header class="ll-sec">
    <div class="ll-wrap">
      <nav class="ll-crumbs" aria-label="Fil d'Ariane">
        <a href="/dashboard">Espace client</a><span>/</span><span>{subscription.pack}</span>
      </nav>
      <div class="ll-pad" style="display:flex;flex-direction:column;gap:12px">
        <h1 class="ll-h1" style="font-size:clamp(26px,3vw,40px)">{subscription.pack}</h1>
        <p class="ll-mono ll-mono--plain">
          Souscrit le {new Date(subscription.created_at).toLocaleDateString("fr-FR")}
        </p>
      </div>
    </div>
  </header>

  <section class="ll-sec">
    <div class="ll-wrap ll-pad" style="display:flex;flex-direction:column;gap:clamp(24px,3vw,36px)">
      <div class="ll-box">
        <h2 class="ll-box__title">Statut du déploiement</h2>
        <div class="ll-progress">
          {statusSteps.map((step, i) => (
            <div
              class:list={[
                "ll-progress__step",
                currentStepIndex >= i && "ll-progress__step--done",
                currentStepIndex === i && "ll-progress__step--now",
              ]}
            >
              <span></span>
              <b>{step.label}</b>
            </div>
          ))}
        </div>
      </div>

      {infra.length > 0 && (
        <div class="ll-box">
          <h2 class="ll-box__title">Infrastructure</h2>
          <dl class="ll-defs">
            {infra.map(([label, value, mono]) => (
              <>
                <dt>{label}</dt>
                <dd style={mono ? "font-family:var(--font-mono);font-size:14px" : ""}>{value}</dd>
              </>
            ))}
          </dl>
        </div>
      )}

      {resources.length > 0 && (
        <div class="ll-box" style="padding:0">
          <h2 class="ll-box__title" style="padding:clamp(22px,2.6vw,32px) 22px 0">Ressources</h2>
          <div style="margin-top:16px">
            {resources.map((resource: any) => (
              <div class="ll-listrow">
                <div>
                  <div class="ll-listrow__name">{resource.title}</div>
                  <div class="ll-listrow__meta">{resource.type}</div>
                </div>
                {resource.file_path && <span class="ll-badge">Télécharger</span>}
              </div>
            ))}
          </div>
        </div>
      )}

      {resources.length === 0 && infra.length === 0 && (
        <div class="ll-note">
          <div class="ll-label">En préparation</div>
          <p>
            Votre déploiement est en cours de préparation. Vous recevrez un email dès que tout sera
            prêt.
          </p>
        </div>
      )}
    </div>
  </section>
</Base>
