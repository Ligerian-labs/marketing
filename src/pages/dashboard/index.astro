---
export const prerender = false;
import Base from "../../layouts/Base.astro";
import { getAuthenticatedUser } from "../../lib/auth";
import { getUserPurchases, FORMATION_TIERS, type FormationTier } from "../../lib/formations";
import db from "../../lib/db";

const user = await getAuthenticatedUser(Astro.cookies);
if (!user) {
  return Astro.redirect("/auth/connexion");
}

const subscriptions = db
  .prepare("SELECT * FROM subscriptions WHERE user_id = ? ORDER BY created_at DESC")
  .all(user.id) as any[];

const purchases = getUserPurchases(user.id);

// Deduplicate purchases — keep only latest per pack
const uniquePurchases = Object.values(
  purchases.reduce((acc: Record<string, any>, p) => {
    if (!acc[p.pack] || new Date(p.created_at) > new Date(acc[p.pack].created_at)) {
      acc[p.pack] = p;
    }
    return acc;
  }, {}),
) as typeof purchases;

// Sort: premium > intermediate > starter
const tierOrder = ["formation-premium", "formation-intermediate", "formation-starter"];
uniquePurchases.sort((a, b) => tierOrder.indexOf(a.pack) - tierOrder.indexOf(b.pack));

const STATUS_LABELS: Record<string, string> = {
  active: "Actif",
  provisioning: "En cours",
  configuring: "Configuration",
  testing: "Tests",
  pending: "En attente",
};

const empty = uniquePurchases.length === 0 && subscriptions.length === 0;
---

<Base title="Espace client — Ligerian Labs" robots="noindex, nofollow">
  <header class="ll-sec">
    <div class="ll-wrap ll-pad" style="display:flex;flex-direction:column;gap:14px">
      <div class="ll-mono" style="font-size:12px;letter-spacing:.16em">Espace client</div>
      <h1 class="ll-h1" style="font-size:clamp(28px,3.4vw,46px)">Bonjour, {user.name}</h1>
      <p class="ll-mono ll-mono--plain">
        {user.email}{user.company ? ` · ${user.company}` : ""}
      </p>
    </div>
  </header>

  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      {empty ? (
        <div class="ll-box" style="display:flex;flex-direction:column;gap:16px;align-items:flex-start">
          <div class="ll-mono">Rien à afficher pour l'instant</div>
          <h2 class="ll-h2 ll-h2--tight">Aucune mission<br />ni formation active</h2>
          <p class="ll-body">
            L'espace se remplit au démarrage d'une mission : avancement des tranches, tableaux de
            bord, livrables et documentation de passation.
          </p>
          <div class="ll-btn-row" style="margin-top:6px">
            <a href="/formations" class="ll-btn">Voir les formations →</a>
            <a href="/contact" class="ll-btn ll-btn--ghost">Parler d'une mission</a>
          </div>
        </div>
      ) : (
        <div style="display:flex;flex-direction:column;gap:clamp(28px,3.4vw,44px)">
          {uniquePurchases.length > 0 && (
            <div>
              <div class="ll-bar__label" style="margin-bottom:14px">01 — Vos formations</div>
              <div class="ll-box" style="padding:0">
                {uniquePurchases.map((purchase: any) => {
                  const formation = FORMATION_TIERS[purchase.pack as FormationTier];
                  const tierDir = formation?.tier_dir || purchase.pack.replace("formation-", "");
                  return (
                    <a href={`/formations/${tierDir}/`} class="ll-listrow">
                      <div>
                        <div class="ll-listrow__name">{formation?.name || purchase.pack}</div>
                        <div class="ll-listrow__meta">{formation?.description}</div>
                      </div>
                      <span class="ll-badge ll-badge--on">Accès complet →</span>
                    </a>
                  );
                })}
              </div>
              <p style="margin:14px 0 0">
                <a href="/formations" class="ll-mono ll-mono--plain">Voir toutes les formations →</a>
              </p>
            </div>
          )}

          {subscriptions.length > 0 && (
            <div>
              <div class="ll-bar__label" style="margin-bottom:14px">
                {uniquePurchases.length > 0 ? "02" : "01"} — Vos services
              </div>
              <div class="ll-box" style="padding:0">
                {subscriptions.map((sub: any) => (
                  <a href={`/dashboard/${sub.id}`} class="ll-listrow">
                    <div>
                      <div class="ll-listrow__name">{sub.pack}</div>
                      <div class="ll-listrow__meta">
                        Souscrit le {new Date(sub.created_at).toLocaleDateString("fr-FR")}
                        {sub.server_ip ? ` · ${sub.server_ip}` : ""}
                      </div>
                    </div>
                    <span
                      class:list={[
                        "ll-badge",
                        sub.status === "active" && "ll-badge--on",
                        sub.status !== "active" && "ll-badge--wait",
                      ]}
                    >
                      {STATUS_LABELS[sub.status] ?? sub.status}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  </section>
</Base>
