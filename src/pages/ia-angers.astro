---
export const prerender = true;
import Base from "../layouts/Base.astro";
import MarketingFrame from "../components/MarketingFrame.astro";
import PageHero from "../components/PageHero.astro";
import SectionBar from "../components/SectionBar.astro";
import CtaBand from "../components/CtaBand.astro";
const faq = [
  { q: "Faut-il déjà avoir un logiciel ?", a: "Non. Le projet peut être une nouvelle application métier ou l'évolution d'un outil existant. Le premier échange précise les utilisateurs et le problème à résoudre." },
  { q: "L'IA est-elle nécessaire à tous les projets ?", a: "Non. Une intégration classique ou une règle métier peut suffire. Un usage IA doit être évalué selon son utilité, ses erreurs possibles, ses données et son coût." },
  { q: "Peut-on se rencontrer à Angers ?", a: "Ligerian Labs est basé à Angers. Les modalités d'une rencontre ou d'une intervention sur site sont à convenir selon le projet. Un échange à distance permet de commencer." },
  { q: "Où seront hébergées nos données ?", a: "Le choix dépend de vos contraintes et des prestataires retenus. Les lieux d'hébergement, accès et règles de conservation doivent être définis avec vous avant la mise en production." },
];
const structuredData = [
  { "@type": "Service", "@id": "https://ligerianlabs.fr/ia-angers/#service", name: "Logiciels sur mesure et intégration IA à Angers", url: "https://ligerianlabs.fr/ia-angers/", provider: { "@id": "https://ligerianlabs.fr/#organization" }, areaServed: { "@type": "City", name: "Angers" } },
  { "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Accueil", item: "https://ligerianlabs.fr/" }, { "@type": "ListItem", position: 2, name: "IA à Angers", item: "https://ligerianlabs.fr/ia-angers/" } ] },
  { "@type": "FAQPage", "@id": "https://ligerianlabs.fr/ia-angers/#faq", mainEntity: faq.map((item) => ({ "@type": "Question", name: item.q, acceptedAnswer: { "@type": "Answer", text: item.a } })) },
];
---
<Base title="Logiciels sur mesure et intégration IA à Angers | Ligerian Labs"
  description="À Angers, Ligerian Labs conçoit des applications métier et intègre l'IA à vos logiciels. Cadrage, développement et préparation de la mise en production."
  ogImage="og-ia-angers" structuredData={structuredData}>
  <MarketingFrame>
    <div class="ll-wrap"><nav class="ll-crumbs" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span>/</span><span aria-current="page">IA à Angers</span></nav></div>
    <PageHero heading="Votre projet logiciel et IA à Angers" label="Angers · Maine-et-Loire · Pays de la Loire"
      intro="Vous dirigez une entreprise ou une équipe dans le bassin angevin ? Ligerian Labs vous aide à cadrer une application métier, faire évoluer vos outils ou y intégrer l'IA.">
      <div class="ll-mono" style="color:inherit">Un premier échange</div><p>Parlons de votre activité, des tâches à faciliter et des outils déjà en place. Les modalités de travail à distance ou sur site sont à convenir ensemble.</p><a href="/contact/">Décrire mon besoin →</a>
    </PageHero>
    <SectionBar label="01 · Choisir le bon point de départ" />
    <section class="ll-sec"><div class="ll-wrap marketing-section"><div class="ll-grid ll-grid--2">
      <a class="ll-cell" href="/developpement-logiciel-sur-mesure/"><h2 class="ll-h3">Applications et logiciels métier</h2><p>Créer un outil interne, un portail client ou une connexion entre vos logiciels.</p><span class="ll-cell__foot">Développement sur mesure →</span></a>
      <a class="ll-cell" href="/integration-ia/"><h2 class="ll-h3">IA dans vos outils existants</h2><p>Assister une tâche ou retrouver une information, avec des critères de qualité et un contrôle humain.</p><span class="ll-cell__foot">Intégration IA →</span></a>
    </div><p class="marketing-note">Vous exploitez déjà un service IA ? Les offres <a href="/offres/#voir">Voir</a>, <a href="/offres/#livrer">Livrer</a>, <a href="/offres/#reconstruire">Reconstruire</a> et <a href="/offres/#automatiser">Automatiser</a> couvrent les coûts, les évaluations et la fiabilité.</p></div></section>
    <SectionBar label="02 · Préparer votre projet" />
    <section class="ll-sec"><div class="ll-wrap marketing-section marketing-columns">
      <div><h2 class="ll-h2">Votre contexte compte</h2><p class="marketing-intro">Une description du processus actuel, des personnes qui l'utilisent et des difficultés rencontrées vaut mieux qu'une liste de technologies. Ajoutez les contraintes de données, les échéances et les logiciels à connecter.</p></div>
      <div><h2 class="ll-h2">Des éléments vérifiables</h2><p class="marketing-intro">Avant de choisir une prestation, examinez les travaux publics et leur état. Le périmètre d'un projet client doit ensuite faire l'objet de sa propre proposition.</p><a href="/realisations/">Projets indépendants et sources →</a><br /><a href="/ia-angers-pme/">Usages IA pour les PME angevines →</a></div>
    </div></section>
    <SectionBar label="03 · Questions fréquentes" />
    <section id="faq" class="ll-sec"><div class="ll-wrap marketing-section"><div class="ll-rows">{faq.map((item) => <div class="ll-row"><h2 class="ll-row__q">{item.q}</h2><p class="ll-row__a">{item.a}</p></div>)}</div></div></section>
    <CtaBand title="Parlons de votre projet à Angers" body="Nouvelle application, logiciel existant ou intégration IA : décrivez les tâches, les utilisateurs et les contraintes." />
  </MarketingFrame>
</Base>
