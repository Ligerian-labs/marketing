---
export const prerender = true;
import Base from "../layouts/Base.astro";
import MarketingFrame from "../components/MarketingFrame.astro";
import PageHero from "../components/PageHero.astro";
import ProjectCards from "../components/ProjectCards.astro";
import SectionBar from "../components/SectionBar.astro";
import CtaBand from "../components/CtaBand.astro";
const personSchema = {
  "@type": "Person", "@id": "https://ligerianlabs.fr/a-propos/#valentin-dosimont",
  name: "Valentin Dosimont", jobTitle: "Fondateur, ingénieur logiciel",
  image: "https://ligerianlabs.fr/brand/valentin-dosimont.jpg",
  worksFor: { "@id": "https://ligerianlabs.fr/#organization" },
};
---
<Base title="À propos · Logiciels et IA à Angers | Ligerian Labs"
  description="Valentin Dosimont, fondateur de Ligerian Labs à Angers. Développement logiciel, intégration IA et travaux indépendants consultables en public."
  active="apropos" ogImage="og-a-propos" structuredData={personSchema}>
  <MarketingFrame>
    <PageHero heading="Le besoin métier, puis les choix techniques" label="À propos · Ligerian Labs"
      intro="Ligerian Labs est un atelier de développement logiciel et d'ingénierie IA basé à Angers. Notre travail relie le cadrage, la construction et l'exploitation de vos outils.">
      <div class="ll-mono" style="color:inherit">Votre interlocuteur</div>
      <img src="/brand/valentin-dosimont.jpg" alt="Valentin Dosimont, fondateur de Ligerian Labs" width="320" height="320" class="portrait" />
      <p>Valentin Dosimont · fondateur</p>
    </PageHero>
    <SectionBar label="01 · Une méthode de travail" />
    <section class="ll-sec"><div class="ll-wrap marketing-section marketing-columns">
      <div><h2 class="ll-h2">Clarifier avant de construire</h2><p class="marketing-intro">Une proposition commence par vos utilisateurs, leurs tâches et les contraintes de votre organisation. Le périmètre, les critères de réception et les décisions techniques doivent être compréhensibles par l'équipe qui utilisera le logiciel.</p></div>
      <div><h2 class="ll-h2">Préparer la suite</h2><p class="marketing-intro">Tests, documentation et passation font partie du travail convenu. L'hébergement, les droits sur les livrables et la maintenance se définissent explicitement, avec les responsabilités de chacun.</p><a href="/developpement-logiciel-sur-mesure/">Le développement sur mesure →</a><br /><a href="/integration-ia/">L'intégration IA →</a></div>
    </div></section>
    <SectionBar label="02 · Des travaux consultables" />
    <section class="ll-sec"><div class="ll-wrap marketing-section"><h2 class="ll-h2">Examiner le travail</h2><p class="marketing-intro">Les projets indépendants ci-dessous donnent accès au code et à ses limites. Ils permettent d'examiner des choix concrets, sans déduire une expérience client ou un résultat qui ne sont pas documentés.</p><ProjectCards /></div></section>
    <CtaBand title="Présentez votre situation" body="Depuis Angers, commençons par un échange sur les utilisateurs, le logiciel existant et les difficultés à résoudre." />
  </MarketingFrame>
</Base>
<style>.portrait { max-width: 100%; height: auto; width: 220px; aspect-ratio: 1; object-fit: cover; border: 2px solid var(--cream); }</style>
