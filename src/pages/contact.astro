---
export const prerender = true;
import Base from "../layouts/Base.astro";
import { LIMITS, PROJECT_TYPES, PROJECT_TYPE_LABELS } from "../lib/contact.ts";

// Existing response commitment confirmed by the founder on 4 November 2026.
const RESPONSE_DELAY = "48 h ouvrées";
const CONTACT_EMAIL = "bonjour@ligerianlabs.fr";

const projectHints: Record<(typeof PROJECT_TYPES)[number], string> = {
  "new-application": "à concevoir et à construire",
  "existing-software": "le faire évoluer, le reprendre ou le fiabiliser",
  maintenance: "organiser son hébergement et son suivi après livraison",
  "ai-integration": "ajouter de l'IA à un outil, ou la mettre en production",
  other: "ça ne rentre pas dans ces cases, ou je ne sais pas encore",
};

const next = [
  `Nous lisons votre message et répondons sous ${RESPONSE_DELAY}.`,
  "Un premier échange précise votre besoin, les priorités et l'existant.",
  "Une proposition précise le périmètre, la durée estimée et le budget. Tout diagnostic distinct est chiffré avant de commencer.",
  "Pour une construction, le tarif du suivi après livraison est également précisé avant le démarrage.",
];

const contactSchema = {
  "@type": "ContactPage",
  "@id": "https://ligerianlabs.fr/contact/#page",
  name: "Contact — Ligerian Labs",
  about: { "@id": "https://ligerianlabs.fr/#organization" },
};
---

<Base
  title="Contact — parlons de votre projet logiciel ou IA | Ligerian Labs"
  description={`Création à 2 000 € par mois de construction, reprise, maintenance ou intégration IA : décrivez votre projet. Réponse sous ${RESPONSE_DELAY}. Angers et à distance.`}
  ogTitle="Contact — parlons de votre projet logiciel ou IA"
  ogDescription={`Une réponse d'ingénieur sous ${RESPONSE_DELAY}. Y compris si ce n'est pas pour nous.`}
  ogImage="og-contact"
  structuredData={contactSchema}
>
  <header class="ll-sec">
    <div class="ll-wrap ll-hero">
      <div class="ll-hero__main" style="gap:20px">
        <div class="ll-mono" style="font-size:12px;letter-spacing:.16em">Contact</div>
        <h1 class="ll-h1">Parlons de<br />votre projet</h1>
        <p class="ll-lede" style="max-width:50ch">
          Décrivez votre projet : un logiciel à construire ou à reprendre, un besoin de maintenance
          ou de l'IA à intégrer. La construction est proposée à 2 000 € par mois, avec un périmètre
          et une durée estimée. Le suivi après livraison est chiffré séparément.
        </p>
      </div>
      <div class="ll-hero__aside ll-hero__aside--panel" style="justify-content:center;gap:18px">
        <div style="display:flex;flex-direction:column;gap:5px">
          <span class="ll-label">Délai de réponse</span>
          <span style="font-weight:700;font-size:17px">{RESPONSE_DELAY}</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:5px">
          <span class="ll-label">Par mail</span>
          <a href={`mailto:${CONTACT_EMAIL}`} style="font-weight:700;font-size:17px">
            {CONTACT_EMAIL}
          </a>
        </div>
        <div style="display:flex;flex-direction:column;gap:5px">
          <span class="ll-label">Où</span>
          <span style="font-weight:700;font-size:17px">Angers · à distance</span>
        </div>
      </div>
    </div>
  </header>

  <section class="ll-sec">
    <div class="ll-wrap">
      <div class="ll-contact">
        <div class="ll-contact__form">
          <div id="form-success" class="ll-alert ll-alert--ok" tabindex="-1" hidden>
            <div class="ll-mono" style="color:inherit">Message envoyé</div>
            <p>Merci, votre demande est bien enregistrée. Nous revenons vers vous sous {RESPONSE_DELAY}, depuis {CONTACT_EMAIL}.</p>
            <p>Un détail à ajouter&nbsp;? Écrivez-nous à <a href={`mailto:${CONTACT_EMAIL}`} style="color:inherit;text-decoration:underline">{CONTACT_EMAIL}</a>.</p>
          </div>

          <div id="form-alert" class="ll-alert ll-alert--err" role="alert" tabindex="-1" hidden>
            <div class="ll-mono" style="color:inherit" id="form-alert-title"></div>
            <p id="form-alert-body"></p>
            <p>
              Vous pouvez aussi nous écrire directement à
              <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
            </p>
          </div>

          <form id="contact-form" class="ll-contact__fields" novalidate>
            <p class="contact-note">Les champs marqués d'un astérisque (*) sont obligatoires.</p>

            <div class="ll-pair">
              <div class="ll-field">
                <label class="ll-label" for="contact-name">Nom <span aria-hidden="true">*</span></label>
                <input class="ll-input" id="contact-name" type="text" name="name" required maxlength={LIMITS.name} autocomplete="name" aria-describedby="error-name" />
                <p class="contact-error" id="error-name" hidden></p>
              </div>
              <div class="ll-field">
                <label class="ll-label" for="contact-email">Email professionnel <span aria-hidden="true">*</span></label>
                <input class="ll-input" id="contact-email" type="email" name="email" required maxlength={LIMITS.email} autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" aria-describedby="error-email" />
                <p class="contact-error" id="error-email" hidden></p>
              </div>
            </div>

            <div class="ll-field">
              <label class="ll-label" for="contact-company">Entreprise <span class="contact-opt">(facultatif)</span></label>
              <input class="ll-input" id="contact-company" type="text" name="company" maxlength={LIMITS.company} autocomplete="organization" aria-describedby="error-company" />
              <p class="contact-error" id="error-company" hidden></p>
            </div>

            <fieldset class="ll-fieldset" aria-describedby="error-projectType">
              <legend>Type de projet <span aria-hidden="true">*</span><span class="contact-sr"> (obligatoire)</span></legend>
              {PROJECT_TYPES.map((value) => (
                <label class="ll-check contact-option">
                  <input type="radio" name="projectType" value={value} required />
                  <span><strong>{PROJECT_TYPE_LABELS[value]}</strong> — {projectHints[value]}</span>
                </label>
              ))}
              <p class="contact-error" id="error-projectType" hidden></p>
            </fieldset>

            <div class="ll-field">
              <label class="ll-label" for="contact-currentTool">Outil ou logiciel actuel <span class="contact-opt">(facultatif)</span></label>
              <input class="ll-input" id="contact-currentTool" type="text" name="currentTool" maxlength={LIMITS.currentTool} aria-describedby="error-currentTool" />
              <p class="contact-error" id="error-currentTool" hidden></p>
            </div>

            <div class="ll-field">
              <label class="ll-label" for="contact-description">Votre projet <span aria-hidden="true">*</span></label>
              <textarea class="ll-input" id="contact-description" name="description" required rows="6" maxlength={LIMITS.description} aria-describedby="hint-description error-description"></textarea>
              <p class="contact-hint" id="hint-description">Le contexte, ce qui existe déjà, et le résultat que vous attendez.</p>
              <p class="contact-error" id="error-description" hidden></p>
            </div>

            <div class="ll-pair">
              <div class="ll-field">
                <label class="ll-label" for="contact-timing">Calendrier <span class="contact-opt">(facultatif)</span></label>
                <input class="ll-input" id="contact-timing" type="text" name="timing" maxlength={LIMITS.timing} aria-describedby="error-timing" placeholder="Ex. : démarrer au printemps" />
                <p class="contact-error" id="error-timing" hidden></p>
              </div>
              <div class="ll-field">
                <label class="ll-label" for="contact-budget">Budget <span class="contact-opt">(facultatif)</span></label>
                <input class="ll-input" id="contact-budget" type="text" name="budget" maxlength={LIMITS.budget} aria-describedby="error-budget" placeholder="Ordre de grandeur" />
                <p class="contact-error" id="error-budget" hidden></p>
              </div>
            </div>

            <div class="ll-field">
              <label class="ll-check contact-option">
                <input type="checkbox" name="consent" required aria-describedby="error-consent" />
                <span style="font-size:14px;color:var(--ink-soft)">
                  J'accepte que ces informations soient utilisées pour répondre à ma demande. Elles
                  ne sont ni revendues ni utilisées à d'autres fins.
                  <a href="/mentions-legales/">Mentions légales</a>. <span aria-hidden="true">*</span><span class="contact-sr"> (obligatoire)</span>
                </span>
              </label>
              <p class="contact-error" id="error-consent" hidden></p>
            </div>

            <div class="ll-hp" aria-hidden="true">
              <label>
                Ne remplissez pas ce champ
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:2px">
              <button type="submit" class="ll-btn ll-btn--lg" id="contact-submit">Envoyer →</button>
              <span class="ll-mono ll-mono--plain">Réponse sous {RESPONSE_DELAY}</span>
            </div>
          </form>
        </div>

        <div class="ll-stack">
          <div class="ll-contact__next">
            <div class="ll-mono" style="margin-bottom:14px">Ce qui se passe ensuite</div>
            <ol class="ll-stack contact-steps" style="gap:12px">
              {next.map((step, i) => (
                <li style="display:grid;grid-template-columns:26px 1fr;gap:12px">
                  <span
                    style="font-family:var(--font-mono);font-size:11px;color:var(--cobalt);padding-top:3px"
                    aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <span style="font-size:15px;line-height:1.5">{step}</span>
                </li>
              ))}
            </ol>
          </div>
          <div class="ll-contact__aside">
            <div class="ll-mono ll-mono--invert">Pas encore prêt&nbsp;?</div>
            <p style="margin:0;font-size:15.5px;line-height:1.55;color:var(--ink-invert)">
              Regardez d'abord les quatre offres et notre approche. Vous saurez plus vite ce dont
              vous avez besoin — et votre message sera meilleur.
            </p>
            <div class="ll-stack" style="gap:9px;margin-top:4px">
              <a href="/offres/" style="font-size:15px;font-weight:700;color:var(--cream)">Les quatre offres →</a>
              <a href="/approche/" style="font-size:15px;font-weight:700;color:var(--cream)">Notre approche →</a>
              <a
                href="https://github.com/Ligerian-labs"
                rel="noopener"
                target="_blank"
                style="font-size:15px;font-weight:700;color:var(--cream)">Le code, en public →</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Author `display` rules on these classes would otherwise beat the hidden attribute. */
  .ll-alert[hidden],
  .ll-contact__fields[hidden] {
    display: none;
  }
  .contact-note,
  .contact-hint {
    margin: 0;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .contact-opt {
    text-transform: none;
    letter-spacing: 0;
  }
  .contact-error {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
  }
  .contact-error::before {
    content: "Erreur — ";
  }
  /* Not colour alone: a heavy left edge marks the invalid field. */
  .ll-input[aria-invalid="true"] {
    border-left-width: 8px;
  }
  .contact-option {
    min-height: 44px;
    align-items: center;
  }
  .contact-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contact-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import type { ContactErrors, ContactField } from "../lib/contact.ts";
  import { submitEnquiry } from "../lib/contact-client.ts";
  import { projectTypeForOffer } from "../data/project-offers.ts";

  const FIELDS: ContactField[] = ["name", "email", "company", "currentTool", "projectType", "description", "timing", "budget", "consent"];

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const selectedProject = projectTypeForOffer(new URLSearchParams(location.search).get("projet"));
  if (selectedProject) {
    const choice = form?.querySelector<HTMLInputElement>(`input[name="projectType"][value="${selectedProject}"]`);
    if (choice) choice.checked = true;
  }
  const success = document.getElementById("form-success");
  const alertBox = document.getElementById("form-alert");
  const alertTitle = document.getElementById("form-alert-title");
  const alertBody = document.getElementById("form-alert-body");
  const submit = document.getElementById("contact-submit") as HTMLButtonElement | null;
  let sending = false;

  function controls(field: ContactField): HTMLElement[] {
    return Array.from(form?.querySelectorAll<HTMLElement>(`[name="${field}"]`) ?? []);
  }

  function clearError(field: ContactField) {
    const slot = document.getElementById(`error-${field}`);
    if (slot) {
      slot.hidden = true;
      slot.textContent = "";
    }
    controls(field).forEach((el) => el.removeAttribute("aria-invalid"));
  }

  function showErrors(errors: ContactErrors) {
    let first: HTMLElement | undefined;
    for (const field of FIELDS) {
      clearError(field);
      const message = errors[field];
      if (typeof message !== "string") continue;
      const slot = document.getElementById(`error-${field}`);
      if (slot) {
        slot.textContent = message;
        slot.hidden = false;
      }
      controls(field).forEach((el) => el.setAttribute("aria-invalid", "true"));
      first ??= controls(field)[0];
    }
    first?.focus();
  }

  function showFailure(title: string, body: string) {
    if (!alertBox || !alertTitle || !alertBody) return;
    alertTitle.textContent = title;
    alertBody.textContent = body;
    alertBox.hidden = false;
    alertBox.focus();
  }

  function finish() {
    sending = false;
    if (submit) {
      submit.disabled = false;
      submit.textContent = "Envoyer →";
    }
    form?.removeAttribute("aria-busy");
  }

  FIELDS.forEach((field) => {
    controls(field).forEach((el) => {
      el.addEventListener("input", () => clearError(field));
      el.addEventListener("change", () => clearError(field));
    });
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (sending) return;
    if (alertBox) alertBox.hidden = true;

    const data = new FormData(form);
    const text = (key: string) => String(data.get(key) ?? "");
    const payload = {
      name: text("name"),
      email: text("email"),
      company: text("company"),
      currentTool: text("currentTool"),
      projectType: text("projectType"),
      description: text("description"),
      timing: text("timing"),
      budget: text("budget"),
      consent: data.get("consent") === "on",
      website: text("website"),
    };

    sending = true;
    form.setAttribute("aria-busy", "true");
    if (submit) {
      submit.disabled = true;
      submit.textContent = "Envoi…";
    }

    const outcome = await submitEnquiry(payload, {
      fetch: window.fetch.bind(window),
      visit: { hostname: location.hostname, automated: navigator.webdriver },
      capture: (name, properties) => (window as any).posthog?.capture?.(name, properties),
    });

    if (outcome.status === "invalid" || outcome.status === "fields") {
      finish();
      showErrors(outcome.errors);
    } else if (outcome.status === "failed") {
      finish();
      showFailure(
        "L'envoi a échoué",
        outcome.reason === "network"
          ? "Le serveur ne répond pas. Vérifiez votre connexion et réessayez."
          : "Votre message n'a pas été enregistré. Réessayez dans un instant.",
      );
    } else {
      form.hidden = true;
      sending = false;
      if (success) {
        success.hidden = false;
        success.focus();
      }
    }
  });
</script>
