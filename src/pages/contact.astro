---
export const prerender = true;
import Base from "../layouts/Base.astro";
import { projectTypes } from "../data/project-offers";

const next = [
  "Nous lisons votre demande et répondons sous 48 h ouvrées.",
  "Un premier échange précise votre besoin, les priorités et l'existant.",
  "Nous vous proposons un périmètre, une durée estimée et un budget. Tout diagnostic payant est chiffré avant de commencer.",
  "Si nous construisons le logiciel, le tarif de suivi prévu est également précisé avant le démarrage.",
];

const contactSchema = {
  "@type": "ContactPage",
  "@id": "https://ligerianlabs.fr/contact#page",
  name: "Contact — Ligerian Labs",
  about: { "@id": "https://ligerianlabs.fr/#organization" },
};
---

<Base
  title="Contact · parlons de votre logiciel | Ligerian Labs"
  description="Création, reprise ou suivi de logiciel : décrivez le besoin, votre outil actuel, votre échéance et votre budget. Réponse sous 48 h ouvrées."
  ogTitle="Contact · parlons de votre logiciel"
  ogDescription="Décrivez votre projet de création, de reprise ou de suivi de logiciel. Réponse sous 48 h ouvrées."
  ogImage="og-contact"
  structuredData={contactSchema}
>
  <header class="ll-sec">
    <div class="ll-wrap ll-hero">
      <div class="ll-hero__main" style="gap:20px">
        <div class="ll-mono" style="font-size:12px;letter-spacing:.16em">Contact</div>
        <h1 class="ll-h1">Parlons de<br />votre projet</h1>
        <p class="ll-lede" style="max-width:50ch">
          Vous voulez créer un outil, reprendre un logiciel ou organiser son suivi ? Décrivez le
          besoin et vos priorités. Nous vous aidons à définir une première étape et son budget.
        </p>
      </div>
      <div class="ll-hero__aside ll-hero__aside--panel" style="justify-content:center;gap:18px">
        <div style="display:flex;flex-direction:column;gap:5px">
          <span class="ll-label">Délai de réponse</span>
          <span style="font-weight:700;font-size:17px">48 h ouvrées</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:5px">
          <span class="ll-label">Par mail</span>
          <a href="mailto:bonjour@ligerianlabs.fr" style="font-weight:700;font-size:17px">
            bonjour@ligerianlabs.fr
          </a>
        </div>
        <div style="display:flex;flex-direction:column;gap:5px">
          <span class="ll-label">Où</span>
          <span style="font-weight:700;font-size:17px">Angers · à distance</span>
        </div>
      </div>
    </div>
  </header>

  <section class="ll-sec">
    <div class="ll-wrap">
      <div class="ll-contact">
        <div class="ll-contact__form">
          <div id="form-status" role="status" aria-live="polite"></div>

          <form id="contact-form" class="ll-contact__fields" novalidate>
          <div class="ll-pair">
            <label class="ll-field">
              <span class="ll-label">Nom *</span>
              <input class="ll-input" type="text" name="name" required placeholder="Prénom et nom" autocomplete="name" />
            </label>
            <label class="ll-field">
              <span class="ll-label">Email *</span>
              <input class="ll-input" type="email" name="email" required placeholder="vous@entreprise.fr" autocomplete="email" />
            </label>
          </div>

          <div class="ll-pair">
            <label class="ll-field">
              <span class="ll-label">Entreprise</span>
              <input class="ll-input" type="text" name="company" placeholder="Nom de la structure" autocomplete="organization" />
            </label>
            <label class="ll-field">
              <span class="ll-label">Outil ou logiciel actuel</span>
              <input class="ll-input" type="text" name="currentTool" maxlength="500" placeholder="Tableur, application, adresse du site…" />
            </label>
          </div>

          <fieldset class="ll-fieldset">
            <legend>Votre besoin *</legend>
            {projectTypes.map((type) => (
              <label class="ll-check project-choice">
                <input type="radio" name="projectType" value={type.value} required />
                <span>{type.label}</span>
              </label>
            ))}
          </fieldset>

          <div class="ll-pair">
            <label class="ll-field">
              <span class="ll-label">Échéance souhaitée</span>
              <input class="ll-input" type="text" name="deadline" maxlength="200" placeholder="Une date, un trimestre, sans urgence…" />
            </label>
            <label class="ll-field">
              <span class="ll-label">Budget envisagé</span>
              <input class="ll-input" type="text" name="budget" maxlength="200" placeholder="Une enveloppe ou à définir ensemble" />
            </label>
          </div>

          <label class="ll-field">
            <span class="ll-label">Le problème à résoudre *</span>
            <textarea
              class="ll-input"
              name="message"
              required
              rows="6"
              placeholder="Qui utilisera le logiciel ? Que doit-il permettre de faire ? Quelles fonctionnalités sont indispensables ?"
            ></textarea>
          </label>

          <label class="ll-check">
            <input type="checkbox" name="rgpd" required />
            <span style="font-size:14px;color:var(--ink-soft)">
              J'accepte que ces informations soient utilisées pour répondre à ma demande. Elles ne
              sont ni revendues ni utilisées à d'autres fins.
              <a href="/mentions-legales">Mentions légales</a>.
            </span>
          </label>

          <div class="ll-hp" aria-hidden="true">
            <label>
              Ne remplissez pas ce champ
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:2px">
            <button type="submit" class="ll-btn ll-btn--lg" id="contact-submit">Envoyer →</button>
            <span class="ll-mono ll-mono--plain">Réponse sous 48 h ouvrées</span>
          </div>
          </form>
        </div>

        <div class="ll-stack">
          <div class="ll-contact__next">
            <div class="ll-mono" style="margin-bottom:14px">Ce qui se passe ensuite</div>
            <div class="ll-stack" style="gap:12px">
              {next.map((step, i) => (
                <div style="display:grid;grid-template-columns:26px 1fr;gap:12px">
                  <span
                    style="font-family:var(--font-mono);font-size:11px;color:var(--cobalt);padding-top:3px"
                  >{String(i + 1).padStart(2, "0")}</span>
                  <span style="font-size:15px;line-height:1.5">{step}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="ll-contact__aside">
            <div class="ll-mono ll-mono--invert">Pas encore prêt&nbsp;?</div>
            <p style="margin:0;font-size:15.5px;line-height:1.55;color:var(--ink-invert)">
              La construction est facturée 2 000 € par mois sur un périmètre convenu. La reprise
              commence par un diagnostic. Le suivi après livraison est chiffré selon votre logiciel.
            </p>
            <div class="ll-stack" style="gap:9px;margin-top:4px">
              <a href="/offres" style="font-size:15px;font-weight:700;color:var(--cream)">Les offres et tarifs →</a>
              <a href="/approche" style="font-size:15px;font-weight:700;color:var(--cream)">Notre approche →</a>
              <a
                href="https://github.com/Ligerian-labs"
                rel="noopener"
                target="_blank"
                style="font-size:15px;font-weight:700;color:var(--cream)">Le code, en public →</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { projectTypes } from "../data/project-offers";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submit = document.getElementById("contact-submit") as HTMLButtonElement | null;

  const requestedType = new URLSearchParams(window.location.search).get("projet");
  if (requestedType && projectTypes.some((type) => type.value === requestedType)) {
    const input = form?.querySelector<HTMLInputElement>(`input[name="projectType"][value="${requestedType}"]`);
    if (input) input.checked = true;
  }

  function render(kind: "ok" | "err", title: string, body: string) {
    if (!status) return;
    status.innerHTML = `<div class="ll-alert ll-alert--${kind}">
      <div class="ll-mono" style="color:inherit">${title}</div>
      <p>${body}</p>
    </div>`;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const formData = new FormData(form);
    if (formData.get("website")) return; // honeypot

    const payload = {
      name: formData.get("name"),
      email: formData.get("email"),
      company: formData.get("company") || null,
      projectType: formData.get("projectType"),
      currentTool: formData.get("currentTool") || null,
      deadline: formData.get("deadline") || null,
      budget: formData.get("budget") || null,
      message: formData.get("message"),
    };

    if ((window as any).posthog) {
      (window as any).posthog.capture("contact_form_submitted", {
        project_type: payload.projectType,
        has_company: !!payload.company,
        has_current_tool: !!payload.currentTool,
      });
    }

    if (submit) {
      submit.disabled = true;
      submit.textContent = "Envoi…";
    }

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));

      form.hidden = true;
      render(
        "ok",
        "Message envoyé",
        "Merci. Nous revenons vers vous sous 48 h ouvrées, depuis bonjour@ligerianlabs.fr.",
      );
      status?.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth", block: "center" });
    } catch {
      render(
        "err",
        "L'envoi a échoué",
        'Écrivez-nous directement à <a href="mailto:bonjour@ligerianlabs.fr">bonjour@ligerianlabs.fr</a>.',
      );
      if (submit) {
        submit.disabled = false;
        submit.textContent = "Envoyer →";
      }
    }
  });
</script>

<style>
  .project-choice { min-height:44px; align-items:center; }
  .project-choice input { margin-top:0; }
</style>
