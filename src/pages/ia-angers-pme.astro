---
export const prerender = true;
import Base from "../layouts/Base.astro";

const useCases = [
  {
    title: "Administratif",
    text: "Tri d'emails, réponses assistées, génération de documents, extraction d'informations depuis PDF et tableurs."
  },
  {
    title: "Commercial",
    text: "Qualification de prospects, relances, synthèses CRM, préparation de rendez-vous et suivi post-call."
  },
  {
    title: "Opérations",
    text: "Automatisation de workflows, contrôle qualité, reporting, alertes et agents IA connectés à vos outils."
  }
];

const structuredData = [
  {
    "@type": "Service",
    "@id": "https://ligerianlabs.fr/ia-angers-pme/#service",
    "name": "IA pour PME à Angers",
    "serviceType": "Audit IA, automatisation et agents IA pour PME",
    "provider": { "@id": "https://ligerianlabs.fr/#business" },
    "areaServed": [
      { "@type": "City", "name": "Angers" },
      { "@type": "AdministrativeArea", "name": "Maine-et-Loire" },
      { "@type": "AdministrativeArea", "name": "Pays de la Loire" }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "name": "PME et TPE"
    },
    "description": "Solutions IA pour PME à Angers : audit, automatisation métier, agents IA sur mesure et formation des équipes."
  },
  {
    "@type": "FAQPage",
    "@id": "https://ligerianlabs.fr/ia-angers-pme/#faq",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Combien coûte un projet IA pour PME à Angers ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Le bon budget dépend du cas d'usage. Ligerian Labs commence par un audit court pour prioriser les automatisations IA avec le meilleur retour sur investissement."
        }
      },
      {
        "@type": "Question",
        "name": "Une PME peut-elle utiliser l'IA sans équipe technique ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Oui. Ligerian Labs conçoit des agents IA et workflows utilisables par les équipes métier, avec formation et accompagnement."
        }
      }
    ]
  }
];
---

<Base
  title="IA Angers PME — Automatisation & agents IA pour PME | Ligerian Labs"
  description="IA pour PME à Angers : audit, automatisation métier, agents IA sur mesure et formation. Ligerian Labs accompagne les PME du Maine-et-Loire."
  structuredData={structuredData}
>
  <section class="max-w-5xl mx-auto px-6 py-24 md:py-32">
    <p class="section-label mb-6">IA Angers PME</p>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6 leading-tight">
      IA pour PME à Angers : automatiser sans recruter une armée
    </h1>
    <p class="text-xl text-text-secondary max-w-3xl leading-relaxed mb-10">
      Votre PME perd du temps sur l'administratif, les relances, les tableaux, les documents, les process qui dépendent d'une seule personne ? C'est exactement là que l'IA devient rentable.
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/contact" class="bg-accent hover:bg-accent-light text-white px-8 py-3 rounded-lg font-medium transition inline-block text-center">
        Auditer ma PME
      </a>
      <a href="/services" class="text-text-secondary hover:text-text transition px-8 py-3 text-center">
        Voir les offres →
      </a>
    </div>
  </section>

  <section class="bg-surface py-20">
    <div class="max-w-6xl mx-auto px-6">
      <p class="section-label mb-4">Cas d'usage PME</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-12">L'IA utile, c'est celle qui enlève du travail répétitif</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {useCases.map((useCase) => (
          <div class="bg-white rounded-2xl p-8 border border-black/5">
            <h3 class="text-xl font-bold mb-3">{useCase.title}</h3>
            <p class="text-text-secondary">{useCase.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-2 gap-16 items-start">
      <div>
        <p class="section-label mb-4">Méthode</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Une approche PME : ROI d'abord, techno ensuite</h2>
        <p class="text-text-secondary text-lg leading-relaxed mb-6">
          On ne commence pas par “mettre de l'IA partout”. On cartographie vos tâches à faible valeur, on estime le gain de temps, puis on choisit le plus petit système IA capable de produire un résultat fiable.
        </p>
        <p class="text-text-secondary text-lg leading-relaxed">
          Objectif : un outil utilisé par l'équipe, pas une démo LinkedIn. Agents IA, automatisations, RAG, workflows n8n/Make, intégration CRM — seulement si ça sert le business.
        </p>
      </div>
      <div class="bg-surface rounded-2xl p-8">
        <h3 class="text-2xl font-bold mb-6">Plan d'action type</h3>
        <ol class="space-y-4 text-text-secondary">
          <li><strong class="text-text">1.</strong> Audit express des process et irritants</li>
          <li><strong class="text-text">2.</strong> Priorisation par gain de temps et risque</li>
          <li><strong class="text-text">3.</strong> Prototype IA sur un cas concret</li>
          <li><strong class="text-text">4.</strong> Déploiement, formation, mesure</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-12">
    <div class="bg-white border border-black/5 rounded-2xl p-8">
      <h2 class="text-3xl font-bold mb-6">Le bon premier projet IA pour une PME</h2>
      <p class="text-text-secondary text-lg leading-relaxed">
        Le meilleur point de départ n'est pas toujours le plus spectaculaire. C'est souvent un process répétitif, fréquent, bien documenté, qui fatigue déjà l'équipe. On le transforme en prototype mesurable avant de parler gros chantier.
      </p>
    </div>
  </section>

  <section class="bg-accent text-white py-20 mx-6 md:mx-auto max-w-6xl rounded-2xl">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Votre PME à Angers veut gagner du temps ?</h2>
      <p class="text-white/70 mb-8 text-lg">Envoyez le process le plus pénible. On vous dira franchement s'il mérite une automatisation IA.</p>
      <a href="/contact" class="bg-white text-accent hover:bg-white/90 px-8 py-3 rounded-lg font-medium transition inline-block">
        Demander un avis IA
      </a>
    </div>
  </section>
</Base>
