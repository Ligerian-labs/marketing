---
export const prerender = true;
import Base from "../layouts/Base.astro";
import SectionBar from "../components/SectionBar.astro";
import CtaBand from "../components/CtaBand.astro";

const notDoing = [
  "Des ateliers de sensibilisation sans suite",
  "Un chatbot sur votre site parce que ça se fait",
  "Des abonnements qui tournent après notre départ",
  "Des promesses de gains sans mesure de départ",
];

const useCases = [
  {
    n: "01",
    title: "Traitement de documents entrants",
    body: "Devis, factures, bons de commande, dossiers. Extraction, contrôle, routage — avec un humain sur les cas douteux uniquement.",
  },
  {
    n: "02",
    title: "Réponses et relances récurrentes",
    body: "Les demandes qui reviennent chaque semaine, préparées automatiquement et validées en un clic plutôt que rédigées à zéro.",
  },
  {
    n: "03",
    title: "Recherche dans vos propres données",
    body: "Vos procédures, contrats et historiques deviennent interrogeables — avec les sources citées, sinon ça ne sert à rien.",
  },
];

const steps = [
  {
    n: "01",
    title: "On chronomètre",
    body: "Combien de temps et d'argent ce processus consomme aujourd'hui. Sans ce chiffre, rien ne commence.",
    when: "SEMAINE 1",
    lead: false,
  },
  {
    n: "02",
    title: "On construit petit",
    body: "Une première version qui traite un sous-ensemble réel, avec vos vraies données et un humain en validation.",
    when: "SEMAINES 2–4",
    lead: false,
  },
  {
    n: "03",
    title: "On compare",
    body: "Même mesure qu'en semaine 1. Le gain est réel ou il ne l'est pas — dans les deux cas vous le savez.",
    when: "SEMAINE 5",
    lead: false,
  },
  {
    n: "04",
    title: "On vous rend les clés",
    body: "Documentation, runbook, et une session avec la personne qui reprendra. Pas d'abonnement caché.",
    when: "SEMAINE 6",
    lead: true,
  },
];

const faq = [
  {
    q: "Faut-il une équipe technique en interne ?",
    a: "Une personne à l'aise avec vos outils suffit pour démarrer. En revanche, il faut quelqu'un qui reprendra à la fin — sinon nous construisons une dépendance, et ce n'est pas ce que nous vendons.",
  },
  {
    q: "Nos données sont sensibles. Où vont-elles ?",
    a: "Décision prise avec vous et écrite : hébergement européen, rétention limitée, ou modèle auto-hébergé quand le dossier le justifie. Chaque option a un coût que nous chiffrons avant, pas après.",
  },
  {
    q: "Et si l'IA se trompe sur un dossier client ?",
    a: "C'est pour ça qu'on place des points de contrôle humains là où l'erreur coûte cher, et qu'on les retire là où elle ne coûte rien. Le taux d'erreur est mesuré, pas espéré.",
  },
  {
    q: "Combien ça coûte à faire tourner tous les mois ?",
    a: "Nous vous donnons un modèle de coûts avec un plafond mensuel appliqué par le code. Vous ne découvrez pas la facture : vous la fixez.",
  },
  {
    q: "Y a-t-il des aides pour financer ce type de projet ?",
    a: "Des dispositifs régionaux et Bpifrance existent pour la transformation numérique des PME. Nous ne sommes pas cabinet de subventions, mais nous fournissons le dossier technique dont vous aurez besoin.",
  },
];

const structuredData = [
  {
    "@type": "Service",
    "@id": "https://ligerianlabs.fr/ia-angers-pme#service",
    name: "IA pour PME à Angers",
    serviceType: "Automatisation mesurée d'un processus métier avec de l'IA",
    provider: { "@id": "https://ligerianlabs.fr/#business" },
    areaServed: [
      { "@type": "City", name: "Angers" },
      { "@type": "AdministrativeArea", name: "Maine-et-Loire" },
      { "@type": "AdministrativeArea", name: "Pays de la Loire" },
    ],
    audience: { "@type": "BusinessAudience", name: "PME et TPE" },
    description:
      "Un processus à la fois, mesuré avant et après, avec passation documentée. Pour les PME d'Angers et des Pays de la Loire.",
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: "https://ligerianlabs.fr/" },
      {
        "@type": "ListItem",
        position: 2,
        name: "IA à Angers",
        item: "https://ligerianlabs.fr/ia-angers",
      },
      { "@type": "ListItem", position: 3, name: "PME" },
    ],
  },
  {
    "@type": "FAQPage",
    "@id": "https://ligerianlabs.fr/ia-angers-pme#faq",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base
  title="IA pour PME à Angers — workflows fiables et mesurés | Ligerian Labs"
  description="IA pour PME à Angers et en Pays de la Loire : automatiser un processus, mesurer ce que ça coûte, garder la main. Diagnostic en deux semaines, périmètre écrit."
  ogImage="og-ia-angers-pme"
  structuredData={structuredData}
>
  <header class="ll-sec">
    <div class="ll-wrap">
      <nav class="ll-crumbs" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a><span>/</span><a href="/ia-angers">IA à Angers</a><span>/</span
        ><span>PME</span>
      </nav>
      <div class="ll-hero">
        <div class="ll-hero__main" style="gap:20px">
          <div class="ll-mono" style="font-size:12px;letter-spacing:.16em">
            PME · Angers &amp; Pays de la Loire
          </div>
          <h1 class="ll-h1" style="font-size:clamp(30px,4vw,54px);line-height:.94">
            L'IA pour<br />une PME&nbsp;:<br />un processus,<br />bien fait
          </h1>
          <p class="ll-lede">
            Vous n'avez pas besoin d'une stratégie IA. Vous avez besoin qu'un processus coûteux
            tourne mieux, que ce soit mesuré, et que personne ne devienne dépendant d'un
            prestataire.
          </p>
          <div class="ll-btn-row" style="margin-top:6px">
            <a href="/contact" class="ll-btn">Décrire votre situation →</a>
          </div>
        </div>
        <div class="ll-hero__aside ll-hero__aside--ink">
          <div class="ll-mono ll-mono--invert">Ce que nous ne faisons pas</div>
          <div class="ll-bullets" style="color:var(--ink-invert)">
            {notDoing.map((item) => (
              <div class="ll-bullet ll-bullet--dash"><span>{item}</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </header>

  <SectionBar label="01 — Là où ça marche vraiment" note="Des processus, pas des idées" />

  <section class="ll-sec">
    <div class="ll-wrap">
      <div class="ll-grid ll-grid--3">
        {useCases.map((item) => (
          <div class="ll-cell" style="min-height:230px;gap:11px">
            <div class="ll-step__num" style="font-size:11px">{item.n}</div>
            <h3 style="font-weight:700;font-size:19px;margin:0;letter-spacing:-.01em;line-height:1.18">
              {item.title}
            </h3>
            <p style="font-size:15px">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      <div class="ll-intro">
        <h2 class="ll-h2 ll-h2--tight">Comment ça<br />se passe</h2>
        <p class="ll-body ll-body--lg" style="max-width:54ch">
          Un processus à la fois. Mesuré avant, mesuré après. Si le chiffre ne bouge pas, on vous le
          dit et on s'arrête — c'est plus honnête et moins cher que de continuer.
        </p>
      </div>
      <div class="ll-grid ll-grid--4 ll-grid--boxed">
        {steps.map((step) => (
          <div class:list={["ll-cell", step.lead && "ll-cell--cobalt"]} style="min-height:210px;gap:10px">
            <div class="ll-step__num" style="font-size:11px">{step.n}</div>
            <h3 style="font-weight:700;font-size:18px;margin:0;letter-spacing:-.01em">{step.title}</h3>
            <p>{step.body}</p>
            <span
              class="ll-mono ll-mono--sm"
              style="margin-top:auto;letter-spacing:.06em;color:inherit;opacity:.75">{step.when}</span
            >
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionBar label="02 — Questions de dirigeant" note="Les vraies, pas les rassurantes" />

  <section class="ll-sec">
    <div class="ll-wrap ll-pad">
      <div class="ll-rows">
        {faq.map((item) => (
          <div class="ll-row">
            <h3 class="ll-row__q">{item.q}</h3>
            <p class="ll-row__a">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Quel processus<br />vous coûte le plus&nbsp;?"
    body="Dites-nous lequel en trois lignes. Nous vous répondrons franchement si l'IA y changerait quelque chose."
    cta="Décrire votre situation →"
  />
</Base>
