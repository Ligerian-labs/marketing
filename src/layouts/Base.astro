---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getAuthenticatedUser } from "../lib/auth";

interface Props {
  title: string;
  description?: string;
  robots?: string;
  /**
   * Social copy. Share cards get their own, shorter wording: the `| Ligerian
   * Labs` suffix is dead weight next to the site name a scraper already shows,
   * and the SEO description is written for a SERP, not a card.
   * Both fall back to the page title / description.
   */
  ogTitle?: string;
  ogDescription?: string;
  /** File name under /brand/og/, without extension. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Article-only Open Graph metadata. */
  publishedTime?: string;
  section?: string;
  tags?: string[];
  /** Underlines the matching nav tab. */
  active?: "offres" | "approche" | "apropos" | "blog" | "";
  /** Set false for full-bleed screens that draw their own shell (connexion). */
  chrome?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Ligerian Labs met l'IA en production et vous rend la main sur ce qu'elle coûte, ce qu'elle fait et si elle s'améliore. Angers, Pays de la Loire.",
  robots = "index, follow, max-image-preview:large",
  ogTitle,
  ogDescription,
  ogImage = "og-accueil",
  ogImageAlt,
  ogType = "website",
  publishedTime,
  section,
  tags = [],
  active = "",
  chrome = true,
  structuredData = [],
} = Astro.props;

const site = Astro.site ?? new URL("https://ligerianlabs.fr");
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(`/brand/og/${ogImage}.png`, site).href;

// Strip the site-name suffix when a page hasn't supplied its own social title.
const socialTitle = ogTitle ?? title.replace(/\s*[|—]\s*Ligerian Labs\s*$/, "");
const socialDescription = ogDescription ?? description;
const socialImageAlt = ogImageAlt ?? `Ligerian Labs — ${socialTitle}`;

const schemaGraph = [
  {
    "@type": "Organization",
    "@id": "https://ligerianlabs.fr/#organization",
    name: "Ligerian Labs",
    url: "https://ligerianlabs.fr",
    email: "bonjour@ligerianlabs.fr",
    logo: "https://ligerianlabs.fr/brand/logo/logo-stacked-ink.png",
    description:
      "Laboratoire d'ingénierie IA à Angers : token ops, mise en production, architecture IA et agents.",
    founder: {
      "@type": "Person",
      name: "Valentin Dosimont",
      jobTitle: "Fondateur",
    },
    foundingDate: "2021",
    sameAs: [
      "https://github.com/Ligerian-labs",
      "https://x.com/LigerianLabs",
      "https://www.tiktok.com/@ligerianlabs",
      "https://www.instagram.com/ligerianlabs",
    ],
  },
  {
    "@type": ["LocalBusiness", "ProfessionalService"],
    "@id": "https://ligerianlabs.fr/#business",
    name: "Ligerian Labs",
    url: "https://ligerianlabs.fr",
    email: "bonjour@ligerianlabs.fr",
    parentOrganization: { "@id": "https://ligerianlabs.fr/#organization" },
    description:
      "Agence et laboratoire d'ingénierie IA à Angers pour équipes produit, PME et collectivités des Pays de la Loire.",
    image: "https://ligerianlabs.fr/brand/og/og-accueil.png",
    priceRange: "€€€",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Angers",
      addressRegion: "Pays de la Loire",
      addressCountry: "FR",
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: 47.4784,
      longitude: -0.5632,
    },
    areaServed: [
      { "@type": "City", name: "Angers" },
      { "@type": "AdministrativeArea", name: "Maine-et-Loire" },
      { "@type": "AdministrativeArea", name: "Pays de la Loire" },
    ],
    knowsAbout: [
      "ingénierie IA",
      "token ops",
      "observabilité des modèles",
      "mise en production IA",
      "architecture IA",
      "agents IA",
    ],
  },
  {
    "@type": "WebSite",
    "@id": "https://ligerianlabs.fr/#website",
    name: "Ligerian Labs",
    url: "https://ligerianlabs.fr",
    inLanguage: "fr-FR",
    publisher: { "@id": "https://ligerianlabs.fr/#organization" },
  },
  ...(Array.isArray(structuredData) ? structuredData : [structuredData]),
].filter(Boolean);

// Prerendered routes have no request, so don't even look for a session there.
let user = null;
if (!Astro.isPrerendered) {
  try {
    user = getAuthenticatedUser(Astro.cookies) || null;
  } catch {
    /* no readable session */
  }
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geo targeting -->
    <meta name="geo.region" content="FR-PDL" />
    <meta name="geo.placename" content="Angers" />
    <meta name="geo.position" content="47.4784;-0.5632" />
    <meta name="ICBM" content="47.4784, -0.5632" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ligerian Labs" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />

    {ogType === "article" && publishedTime && (
      <>
        <meta property="article:published_time" content={publishedTime} />
        <meta property="article:author" content="Ligerian Labs" />
        {section && <meta property="article:section" content={section} />}
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@LigerianLabs" />
    <meta name="twitter:creator" content="@LigerianLabs" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/logo/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/brand/logo/favicon-180.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;700;800&family=Archivo:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- PostHog Analytics & A/B Testing -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageviewId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_RWvhEosblAK0FyygISQWlIb0ljI7EoYwQLQYlMh6wK4', {
        api_host: 'https://ligerianlabs.fr/ingest',
        ui_host: 'https://eu.posthog.com',
        person_profiles: 'identified_only',
        capture_pageview: true,
        capture_pageleave: true,
        autocapture: true
      });
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": schemaGraph })}
    />
  </head>
  <body>
    {chrome ? (
      <>
        <a class="ll-skip" href="#contenu">Aller au contenu</a>
        <Header active={active} user={user} />
        <main id="contenu">
          <slot />
        </main>
        <Footer />
      </>
    ) : (
      <slot />
    )}
  </body>
</html>
