---
import { projects as publicProjects } from "../data/projects";
interface Props { label?: string; stats?: boolean; projects?: number; }
const { label = "Le travail en public", projects = publicProjects.length } = Astro.props;
---
<section class="ll-sec ll-sec--ink"><div class="ll-wrap ll-pad"><div class="ll-proof">
  <div><div class="ll-mono ll-mono--invert">{label}</div><h2 class="ll-h2" style="margin-top:20px">Des projets à examiner</h2><p class="ll-body" style="margin-top:20px">Des travaux indépendants, avec accès au code et une présentation de leur état. Ils ne constituent pas des références clients.</p><a href="/realisations/">Toutes les réalisations →</a></div>
  <div class="ll-stack">{publicProjects.slice(0, projects).map((project) => <a class="ll-oss" href={`/realisations/${project.slug}/`}><div class="ll-oss__name">{project.name}</div><div class="ll-oss__what">{project.summary}<br />{project.status}</div></a>)}</div>
</div></div></section>
<style>.ll-proof > *, .ll-oss > * { min-width: 0; overflow-wrap: anywhere; }</style>
