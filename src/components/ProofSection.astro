---
import { openSource } from "../data/offers";

interface Props {
  label?: string;
  /** Homepage keeps the stat strip; /a-propos does not. */
  stats?: boolean;
  projects?: number;
}

const { label = "04 — La preuve", stats = false, projects = openSource.length } = Astro.props;
const list = openSource.slice(0, projects);
---

<section class="ll-sec ll-sec--ink">
  <div class="ll-wrap ll-pad">
    <div class="ll-proof">
      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="ll-mono ll-mono--invert" style="letter-spacing:.16em;font-size:11.5px">{label}</div>
        <h2 class="ll-h2 ll-h2--tight">Nous construisons<br />en public</h2>
        <p class="ll-body" style="max-width:40ch;font-size:16px">
          Pas d'études de cas anonymisées : le code est lisible. L'outillage que nous déployons
          chez vous vient de ce que nous maintenons nous-mêmes.
        </p>
        <a
          href="https://github.com/Ligerian-labs"
          rel="noopener"
          target="_blank"
          style="font-family:var(--font-mono);font-size:12.5px;letter-spacing:.06em;margin-top:4px"
        >
          github.com/Ligerian-labs →
        </a>
      </div>

      <div class="ll-stack">
        {list.map((project) => (
          <div class="ll-oss">
            <div class="ll-oss__name">{project.name}</div>
            <div class="ll-oss__what">{project.what}</div>
          </div>
        ))}

        {stats && (
          <div class="ll-stats ll-stats--ink">
            <div class="ll-stat">
              <div class="ll-stat__n">12+</div>
              <div class="ll-stat__k">Ans en production</div>
            </div>
            <div class="ll-stat">
              <div class="ll-stat__n" style="color:var(--cobalt)">60+</div>
              <div class="ll-stat__k">Dépôts publics</div>
            </div>
            <div class="ll-stat">
              <div class="ll-stat__n">E2E</div>
              <div class="ll-stat__k">Cadrage → déploiement</div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
