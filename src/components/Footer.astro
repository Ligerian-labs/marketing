---
const offers = [
  { href: "/developpement-logiciel-sur-mesure/", label: "Logiciels sur mesure" },
  { href: "/integration-ia/", label: "Intégration IA" },
  { href: "/offres/#voir", label: "Voir — Token ops" },
  { href: "/offres/#livrer", label: "Livrer — mise en production" },
  { href: "/offres/#reconstruire", label: "Reconstruire — l'IA au cœur" },
  { href: "/offres/#automatiser", label: "Automatiser — agents" },
];

const territory = [
  { href: "/realisations/", label: "Réalisations" },
  { href: "/contact/", label: "Contact" },
  { href: "/ia-angers/", label: "Agence IA à Angers" },
  { href: "/ia-angers-pme/", label: "IA pour PME à Angers" },
  { href: "/a-propos/", label: "À propos" },
  { href: "/approche/", label: "Notre approche" },
  { href: "/blog/", label: "Blog" },
];

const elsewhere = [
  { href: "https://github.com/Ligerian-labs", label: "GitHub" },
  { href: "https://x.com/LigerianLabs", label: "X" },
  { href: "https://www.instagram.com/ligerianlabs", label: "Instagram" },
  { href: "https://www.tiktok.com/@ligerianlabs", label: "TikTok" },
];

const year = new Date().getFullYear();
---

<footer class="ll-foot">
  <div class="ll-wrap">
    <div class="ll-foot__cols">
      <div class="ll-foot__col" style="gap:16px">
        <a href="/" class="ll-logo" style="color:var(--cream)">Ligerian <span>Labs</span></a>
        <p class="ll-foot__blurb">
          Logiciels sur mesure et intégration IA. Depuis Angers, du cadrage à la mise en production.
        </p>
        <a href="mailto:bonjour@ligerianlabs.fr" style="font-size:15px;font-weight:700">
          bonjour@ligerianlabs.fr
        </a>
      </div>

      <div class="ll-foot__col">
        <div class="ll-foot__head">Services</div>
        {offers.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>

      <div class="ll-foot__col">
        <div class="ll-foot__head">Découvrir</div>
        {territory.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>

      <div class="ll-foot__col">
        <div class="ll-foot__head">Ailleurs</div>
        {elsewhere.map((link) => (
          <a href={link.href} rel="me noopener" target="_blank">{link.label}</a>
        ))}
        <a href="/kit-presse/">Kit presse</a>
      </div>
    </div>

    <div class="ll-foot__rule"></div>

    <div class="ll-foot__legal">
      <span>© {year} Ligerian Labs · Angers, Pays de la Loire · 47.4784 N, −0.5632 E</span>
      <a href="/mentions-legales/">Mentions légales</a>
    </div>
  </div>
</footer>

<style>
  .ll-foot__col { min-width: 0; overflow-wrap: anywhere; }
  .ll-foot__legal { flex-wrap: wrap; }
</style>
