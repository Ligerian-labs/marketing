---
import Logo from "./Logo.astro";

interface Props {
  /** Underlines the matching tab in cobalt. */
  active?: "offres" | "approche" | "apropos" | "blog" | "";
  user?: { name: string; email: string } | null;
}

const { active = "", user = null } = Astro.props;

const tabs = [
  { key: "offres", href: "/offres", label: "Offres" },
  { key: "approche", href: "/approche", label: "Approche" },
  { key: "apropos", href: "/a-propos", label: "À propos" },
  { key: "blog", href: "/blog", label: "Blog" },
] as const;
---

<div class="ll-nav">
  <div class="ll-wrap">
    <div class="ll-nav__bar">
      <Logo />

      <nav class="ll-nav__links" aria-label="Navigation principale">
        {tabs.map((tab) => (
          <a
            href={tab.href}
            class="ll-nav__link"
            aria-current={active === tab.key ? "page" : undefined}
          >
            {tab.label}
          </a>
        ))}
      </nav>

      <div class="ll-nav__end">
        {user ? (
          <a href="/dashboard" class="ll-nav__minor">{user.name.split(" ")[0]}</a>
        ) : (
          <a href="/auth/connexion" class="ll-nav__minor">Connexion</a>
        )}
        <a href="/contact" class="ll-nav__cta">Parlons de votre projet</a>
        <button
          type="button"
          class="ll-nav__burger"
          id="ll-burger"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="ll-nav-panel"
        >
          <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true">
            <rect width="22" height="2" y="0" fill="currentColor"></rect>
            <rect width="22" height="2" y="7" fill="currentColor"></rect>
            <rect width="22" height="2" y="14" fill="currentColor"></rect>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="ll-nav__panel" id="ll-nav-panel">
    <div class="ll-wrap">
      {tabs.map((tab) => <a href={tab.href}>{tab.label}</a>)}
      <a href="/ia-angers">Agence IA à Angers</a>
      <a href="/ia-angers-pme">IA pour PME</a>
      {user ? (
        <>
          <a href="/dashboard">Espace client</a>
          <a href="/api/auth/logout">Déconnexion</a>
        </>
      ) : (
        <a href="/auth/connexion">Connexion</a>
      )}
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById("ll-burger");
    var panel = document.getElementById("ll-nav-panel");
    if (!btn || !panel) return;
    btn.addEventListener("click", function () {
      var open = panel.classList.toggle("open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
      btn.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
    });
  })();
</script>
