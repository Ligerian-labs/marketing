---
interface Props {
  heading: string;
  intro: string;
  label: string;
  contactHref?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  heading, intro, label,
  contactHref = "/contact/",
  secondaryHref = "/realisations/",
  secondaryLabel = "Voir les réalisations",
} = Astro.props;
---
<header class="ll-sec">
  <div class="ll-wrap ll-hero">
    <div class="ll-hero__main">
      <div class="ll-mono">{label}</div>
      <h1 class="ll-h1">{heading}</h1>
      <p class="ll-lede">{intro}</p>
      <div class="ll-btn-row">
        <a href={contactHref} class="ll-btn">Parler de mon projet →</a>
        <a href={secondaryHref} class="ll-btn ll-btn--ghost">{secondaryLabel}</a>
      </div>
    </div>
    <aside class="ll-hero__aside ll-hero__aside--cobalt"><slot /></aside>
  </div>
</header>
<style>
  h1 { overflow-wrap: anywhere; text-wrap: balance; }
  aside { font-size: 17px; line-height: 1.65; }
  aside :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 4px; }
</style>
