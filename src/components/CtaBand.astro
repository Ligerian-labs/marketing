---
interface Props {
  title: string;
  body?: string;
  label?: string;
  cta?: string;
  href?: string;
}

const {
  title,
  body,
  label = "Prochaine étape",
  cta = "Parlons de votre projet →",
  href = "/contact",
} = Astro.props;
---

<section class="ll-cta">
  <div class="ll-wrap ll-cta__inner">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="ll-cta__label">{label}</div>
      <h2 set:html={title} />
      {body && <p>{body}</p>}
    </div>
    <a href={href} class="ll-btn ll-btn--cream">{cta}</a>
  </div>
</section>
