---
interface Props {
  title: string;
  body?: string;
  label?: string;
  cta?: string;
  href?: string;
}

const {
  title,
  body,
  label = "Prochaine étape",
  cta = "Parlons de votre projet →",
  href = "/contact/",
} = Astro.props;
---

<section class="ll-cta">
  <div class="ll-wrap ll-cta__inner">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="ll-cta__label">{label}</div>
      <h2 set:html={title} />
      {body && <p>{body}</p>}
    </div>
    <a href={href} class="ll-btn ll-btn--cream">{cta}</a>
  </div>
</section>

<style>
  .ll-cta__inner > div { min-width: 0; max-width: 100%; }
  h2, p { overflow-wrap: anywhere; }
  .ll-btn { max-width: 100%; white-space: normal; text-align: center; }
  @media (max-width: 620px) { h2 { font-size: clamp(24px, 7vw, 34px); line-height: 1.1; } }
</style>
